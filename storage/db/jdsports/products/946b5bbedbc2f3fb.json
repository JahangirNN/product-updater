d><td style='padding:6px 12px;text-align:center;'>EU 37.5</td><td style='padding:6px 12px;text-align:center;'>Out of Stock</td></tr><tr><td style='padding:6px 12px;text-align:center;'>US 5.5Y</td><td style='padding:6px 12px;text-align:center;'>UK 5</td><td style='padding:6px 12px;text-align:center;'>EU 38</td><td style='padding:6px 12px;text-align:center;'>Out of Stock</td></tr><tr><td style='padding:6px 12px;text-align:center;'>US 6.0Y</td><td style='padding:6px 12px;text-align:center;'>UK 5.5</td><td style='padding:6px 12px;text-align:center;'>EU 38.5</td><td style='padding:6px 12px;text-align:center;'>Out of Stock</td></tr><tr><td style='padding:6px 12px;text-align:center;'>US 6.5Y</td><td style='padding:6px 12px;text-align:center;'>UK 6</td><td style='padding:6px 12px;text-align:center;'>EU 39</td><td style='padding:6px 12px;text-align:center;'>Out of Stock</td></tr><tr><td style='padding:6px 12px;text-align:center;'>US 7.0Y</td><td style='padding:6px 12px;text-align:center;'>UK 6</td><td style='padding:6px 12px;text-align:center;'>EU 40</td><td style='padding:6px 12px;text-align:center;'>Out of Stock</td></tr></tbody>\n    </table>\n  </div>\n</details>\n",
