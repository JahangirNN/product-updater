d><td style='padding:6px 12px;text-align:center;'>EU 26</td><td style='padding:6px 12px;text-align:center;'>Out of Stock</td></tr><tr><td style='padding:6px 12px;text-align:center;'>US 10C</td><td style='padding:6px 12px;text-align:center;'>UK 9.5</td><td style='padding:6px 12px;text-align:center;'>EU 27</td><td style='padding:6px 12px;text-align:center;'>Out of Stock</td></tr></tbody>\n    </table>\n  </div>\n</details>\n",
