      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated Maisons"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Explore by Brand"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Intro narrative"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop columns per row",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns per row",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "card_aspect_ratio",
      "label": "Card aspect ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "3 / 4", "label": "Classic (3:4)" }
      ],
      "default": "4 / 5"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Brand collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image or logo",
          "info": "Overrides collection image and first product image."
