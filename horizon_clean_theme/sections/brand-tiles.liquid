        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand tiles",
      "blocks": [
        { "type": "brand", "settings": { "collection": "coach", "title": "COACH", "subheading": "New York 1941" } },
        { "type": "brand", "settings": { "collection": "michael-kors", "title": "Michael Kors", "subheading": "Jet Set Luxury" } },
        { "type": "brand", "settings": { "collection": "tissot", "title": "Tissot", "subheading": "Swiss Horology 1853" } },
        { "type": "brand", "settings": { "collection": "jw-pei", "title": "JW PEI", "subheading": "Modern Vegan Leather" } },
        { "type": "brand", "settings": { "collection": "movado", "title": "Movado", "subheading": "Modernist Museum Dial" } },
        { "type": "brand", "settings": { "collection": "citizen", "title": "Citizen", "subheading": "Eco-Drive Technology" } },
        { "type": "brand", "settings": { "collection": "versace", "title": "Versace", "subheading": "Italian Heritage" } },
        { "type": "brand", "settings": { "collection": "seiko", "title": "Seiko", "subheading": "Japanese Precision" } },
        { "type": "brand", "settings": { "collection": "nike", "title": "NIKE", "subheading": "Court & Air Heritage" } },
