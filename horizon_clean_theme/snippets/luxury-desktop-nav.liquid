<script>
  (function() {
    if (window._luxuryNavInit) return;
    window._luxuryNavInit = true;
    function initLuxuryNav() {
      const detailsList = document.querySelectorAll('.luxury-nav__details');
      detailsList.forEach(function(details) {
        let timeout;
        const parent = details.closest('.luxury-nav-item') || details;
        parent.addEventListener('mouseenter', function() {
          clearTimeout(timeout);
          detailsList.forEach(function(d) { if (d !== details) d.removeAttribute('open'); });
          details.setAttribute('open', '');
        });
        parent.addEventListener('mouseleave', function() {
          timeout = setTimeout(function() {
            details.removeAttribute('open');
          }, 150);
        });
        const summary = details.querySelector('summary');
        if (summary) {
          summary.addEventListener('click', function(e) {
            const followLink = summary.getAttribute('data-follow-link');
            if (followLink && window.innerWidth >= 990) {
              window.location.href = followLink;
            }
          });
        }
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLuxuryNav);
    } else {
      initLuxuryNav();
    }
  })();
</script>
