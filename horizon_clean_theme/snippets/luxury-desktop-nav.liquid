  }

  .luxury-directory-name {
    font-family: var(--text-font-family);
    font-size: 0.75rem;
    font-weight: 600;
    color: #222222;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.18s ease;
  }

  .luxury-directory-link:hover .luxury-directory-name {
    color: #c9a876;
  }

  .luxury-directory-badge {
    font-size: 0.625rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #8c827a;
    background: rgba(0, 0, 0, 0.035);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    font-weight: 500;
    transition: all 0.18s ease;
  }

  .luxury-directory-link:hover .luxury-directory-badge {
    background: rgba(201, 168, 118, 0.15);
    color: #7d6029;
  }

  /* Column 4: Editorial Showcase / Heritage Card */
  .luxury-editorial-card {
    background: #fbfaf8;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-top: 2px solid #c9a876;
    border-radius: 2px;
    padding: 1.5rem !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    box-sizing: border-box !important;
    min-height: 100%;
    position: relative;
    overflow: hidden;
  }

  .luxury-editorial-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a876;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .luxury-editorial-crest {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(201, 168, 118, 0.08);
    border: 1px solid rgba(201, 168, 118, 0.25);
    margin: 0.75rem 0 0.75rem 0;
    color: #c9a876;
  }

  .luxury-editorial-title {
    font-family: var(--heading-font-family);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.35;
    color: #1a1a1a;
    margin: 0 0 0.5rem 0;
  }

  .luxury-editorial-text {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: #666666;
    margin: 0 0 1rem 0;
  }

  .luxury-editorial-chips {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .luxury-editorial-chip {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8c827a;
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.05);
    padding: 0.2rem 0.45rem;
    border-radius: 2px;
  }

  /* Champagne Gold Hover Transitions */
  .luxury-nav__trigger:hover {
    color: #c9a876 !important;
  }
  .luxury-nav-item:hover .luxury-nav__trigger {
    color: #c9a876 !important;
  }
  .luxury-nav__details[open] > .luxury-nav__trigger {
    color: #c9a876 !important;
  }
  .luxury-mega-menu__col a:hover {
    color: #c9a876 !important;
    transform: translateX(2px);
    transition: transform 0.2s ease, color 0.2s ease;
  }
  @media (min-width: 990px) {
    .luxury-nav__details:not([open]) > .luxury-mega-menu {
      display: none !important;
    }
    .luxury-nav-item:hover > .luxury-nav__details > .luxury-mega-menu,
    .luxury-nav__details[open] > .luxury-mega-menu {
      display: block !important;
    }
  }

</style>
{%- endif -%}

