
<style>
  .header-sidebar__sub-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #ffffff;
    z-index: 10;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    padding-bottom: max(3.5rem, env(safe-area-inset-bottom, 2.5rem));
  }
  .header-sidebar__sub-panel[hidden] {
    display: none !important;
  }
  .header-sidebar__linklist,
  .header-sidebar__linklist ul,
  .header-sidebar__sub-panel ul,
  .header-sidebar__sub-panel li {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .header-sidebar__back-button {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 1rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1a1a1a;
    background: #faf8f5;
    border: none;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    cursor: pointer;
    width: 100%;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .header-sidebar__back-button:hover {
    background: #f4efe8;
    color: #c9a876;
  }
  .header-sidebar__back-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #c9a876;
    font-size: 1.15rem;
  }
  .header-sidebar__linklist-button {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.25rem;
    color: #1a1a1a;
    text-decoration: none;
    font-size: 0.875rem;
  }
  .header-sidebar__nested-linklist {
    padding: 0.5rem 1.25rem 0.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .header-sidebar__nested-linklist a {
    color: #555555;
    text-decoration: none;
    font-size: 0.8125rem;
    transition: color 0.2s ease;
  }
  .header-sidebar__nested-linklist a:hover {
    color: #c9a876;
  }
</style>

{%- comment -%}
  Luxury 3-Tier Sidebar Panels (ADR 0022)
  Provides Women, Men, and Designers hierarchical navigation panels for Horizon Quiet Luxury header-sidebar.
{%- endcomment -%}

