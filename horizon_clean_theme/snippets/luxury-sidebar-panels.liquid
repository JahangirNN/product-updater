<script>
  (function() {
    if (window._luxuryPanelsInit) return;
    window._luxuryPanelsInit = true;
    function initSidebarPanels() {
      // Handle opening panels via button[aria-controls]
      document.querySelectorAll('button[aria-controls^="header-panel-"]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const targetId = this.getAttribute('aria-controls');
          const targetPanel = document.getElementById(targetId);
          if (targetPanel) {
            targetPanel.removeAttribute('hidden');
            targetPanel.classList.add('is-active');
            targetPanel.style.transform = 'translateX(0)';
          }
        });
      });
      // Handle back button closing panels via [data-action="close-panel"]
      document.querySelectorAll('[data-action="close-panel"]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const panel = this.closest('.header-sidebar__sub-panel');
          if (panel) {
            panel.classList.remove('is-active');
            panel.setAttribute('hidden', '');
            panel.style.transform = 'translateX(100%)';
          }
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSidebarPanels);
    } else {
      initSidebarPanels();
    }
  })();
</script>
