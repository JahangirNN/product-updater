    color: #888888 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    width: 38% !important;
    padding-right: 1rem !important;
  }

  .bag-specifications td:last-child,
  .watch-specifications td:last-child,
  .prose .bag-specifications td:last-child,
  .prose .watch-specifications td:last-child {
    font-size: 0.8125rem !important; /* 13px */
