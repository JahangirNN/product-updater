<!-- Maison Provenance & Savings Pill (ADR 0022 Whole-Rupee INR Charm Pricing) -->
<div class="luxury-pdp-maison">
  <span class="luxury-pdp-maison__tag">{{ category_tag }}</span>
</div>

{%- if has_discount -%}
  {%- assign formatted_savings = savings_amount | money_without_trailing_zeros | replace: '.00', '' -%}
  <div class="luxury-pdp-savings-row">
    <span class="luxury-pdp-savings-badge">
      Save {{ savings_percent }}% ({{ formatted_savings }} off)
    </span>
    <span class="luxury-pdp-tax-notice">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      All Import Duties & Taxes Included
    </span>
  </div>
{%- endif -%}

{%- comment -%} ==================== FLOATING STICKY QUICK-BUY BAR ==================== {%- endcomment -%}
<div id="luxury-sticky-buy-bar" class="luxury-sticky-buy-bar" aria-hidden="true">
  <div class="luxury-sticky-buy-bar__inner">
    <div class="luxury-sticky-buy-bar__left">
      {%- if product.featured_media -%}
        <img 
          src="{{ product.featured_media | image_url: width: 100 }}" 
          alt="{{ product.title | escape }}" 
          class="luxury-sticky-buy-bar__image" 
          width="44" 
          height="44" 
          loading="lazy"
        >
      {%- endif -%}
      <div class="luxury-sticky-buy-bar__details">
        <p class="luxury-sticky-buy-bar__title">{{ product.title }}</p>
        <div class="luxury-sticky-buy-bar__meta">
          <span class="luxury-sticky-buy-bar__price">
            {%- if settings.currency_code_enabled -%}
              {{- current_variant.price | money_with_currency | replace: '.00', '' -}}
            {%- else -%}
              {{- current_variant.price | money_without_trailing_zeros | replace: '.00', '' -}}
            {%- endif -%}
          </span>
          {%- unless product.has_only_default_variant -%}
            <span class="luxury-sticky-buy-bar__variant">· {{ current_variant.title }}</span>
          {%- endunless -%}
        </div>
      </div>
    </div>
    
    {%- assign p_type_lower = product.type | downcase -%}
    {%- assign p_tags_lower = product.tags | join: ',' | downcase -%}
    {%- if p_type_lower contains 'footwear' or p_type_lower contains 'shoes' or p_tags_lower contains 'footwear' or p_tags_lower contains 'sneakers' -%}
    <label class="sticky-checkcheck-toggle" style="display: flex; align-items: center; gap: 0.35rem; font-size: 0.6875rem; color: #10b981; font-weight: 600; cursor: pointer; white-space: nowrap; margin-right: 0.5rem;">
      <input type="checkbox" id="sticky-checkcheck-addon" style="accent-color: #10b981; width: 14px; height: 14px; cursor: pointer;">
      <span>+ CheckCheck (+₹699)</span>
    </label>
    {%- endif -%}

    <button type="button" class="luxury-sticky-buy-bar__cta" id="luxury-sticky-buy-btn">
      Add to Bag
    </button>
  </div>
</div>

<script>
  (function() {
    function initStickyBuyBar() {
      var stickyBar = document.getElementById('luxury-sticky-buy-bar');
      var mainBuyBtn = document.querySelector('.buy-buttons-block button, .buy-buttons button, [name="add"], .product-form__submit, form[action*="/cart/add"] [type="submit"], .product-form form [type="submit"]');
      var stickyBtn = document.getElementById('luxury-sticky-buy-btn');

      if (!stickyBar || !mainBuyBtn) return;

      // Synchronize sticky quick-buy bar with CheckCheck certification toggle
      var mainCc = document.getElementById('checkcheck-addon-checkbox');
      var stickyCc = document.getElementById('sticky-checkcheck-addon');
      if (mainCc && stickyCc) {
        stickyCc.checked = mainCc.checked;
        mainCc.addEventListener('change', function() { stickyCc.checked = mainCc.checked; });
        stickyCc.addEventListener('change', function() {
          mainCc.checked = stickyCc.checked;
          mainCc.dispatchEvent(new Event('change', { bubbles: true }));
        });
      }

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) {
            stickyBar.classList.add('is-visible');
            stickyBar.setAttribute('aria-hidden', 'false');
          } else {
            stickyBar.classList.remove('is-visible');
            stickyBar.setAttribute('aria-hidden', 'true');
          }
        });
      }, { rootMargin: '0px 0px -100px 0px' });

      observer.observe(mainBuyBtn);

      if (stickyBtn) {
        stickyBtn.addEventListener('click', function(e) {
          e.preventDefault();
          mainBuyBtn.click();
        });
      }

      // Live synchronize sticky buy bar price & variant with selected variant
      var vp = document.querySelector('variant-picker');
      if (vp) {
        vp.addEventListener('change', function(e) {
          var target = e.target;
          if (target && target.dataset) {
            var pText = target.dataset.variantPrice;
            var vTitle = target.value;
            if (pText) {
              var sPrice = document.querySelector('.luxury-sticky-buy-bar__price');
              if (sPrice) sPrice.textContent = pText;
            }
            if (vTitle) {
              var sVar = document.querySelector('.luxury-sticky-buy-bar__variant');
              if (sVar) sVar.textContent = '· ' + vTitle;
            }
          }
        });
      }
    }

    function sanitizeSizeGuideUI() {
      var accordions = document.querySelectorAll('.size-guide-accordion');
      accordions.forEach(function(acc) {
        var summary = acc.querySelector('summary');
        if (summary) {
          // Remove ruler emojis and unicode symbols
          summary.innerHTML = summary.innerHTML
            .replace(/[\u{1F300}-\u{1F9FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}]/gu, '')
            .replace(/[📏📐]/g, '')
            .trim();
        }

        var accText = acc.innerText.toLowerCase();
        // 1. Hide placeholder dummy sizing texts
        if (accText.includes('standard luxury sizing profile') || 
            accText.includes('accommodates daily essentials')) {
          acc.style.display = 'none';
          return;
        }

        // 2. Hide care/cleaning/protector items
        var pageTitle = (document.querySelector('h1, .product-title, .product-info__title') || {}).innerText || '';
        var careTerms = ['protector', 'cleaner', 'spray', 'polish', 'conditioner', 'care kit', 'stain remover', 'refresher', 'umbrella'];
        var isCare = careTerms.some(function(t) { return pageTitle.toLowerCase().includes(t); });
        if (isCare) {
          acc.style.display = 'none';
          return;
        }

        // 3. Check for table existence and rows
        var table = acc.querySelector('table');
        if (table) {
          var rows = table.querySelectorAll('tbody tr');
          if (rows.length === 0) {
            acc.style.display = 'none';
          }
        }
      });

      // 4. Sanitize and elevate raw unpunctuated summary dumps
      var summaries = document.querySelectorAll('.product-summary');
      summaries.forEach(function(s) {
        var text = s.innerText || '';
        if (text.includes('Style No.') || (text.includes('Zip-top closure') && !text.includes('.'))) {
          var titleEl = document.querySelector('h1, .product-title, .product-info__title');
          var pTitle = titleEl ? titleEl.innerText.trim() : 'This designer piece';
          s.innerText = pTitle + ' exemplifies quintessential luxury craftsmanship and timeless design, balancing refined elegance with everyday versatility.';
        }
      });
    }

    function initConciergeAdvisorAction() {
      var buyBtnContainer = document.querySelector('.buy-buttons-block, .buy-buttons, form[action*="/cart/add"], .product-form');
      if (!buyBtnContainer || document.getElementById('luxury-pdp-advisor-inquire')) return;

      var rawTitle = {{ product.title | json }} || document.title;
      var pTitle = encodeURIComponent(rawTitle);
      var pUrl = encodeURIComponent(window.location.href);
      var waUrl = "https://wa.me/919106951947?text=" + encodeURIComponent("Hello The Rare Avenue, I have an inquiry regarding ") + pTitle + "%20(" + pUrl + ")";

      var container = document.createElement('div');
      container.id = 'luxury-pdp-advisor-inquire';
      container.style.marginTop = '0.75rem';
      container.innerHTML = `
        <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="luxury-pdp-concierge-action" aria-label="Inquire via WhatsApp with Client Advisor">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
          <span>Inquire via WhatsApp with Advisor</span>
        </a>
      `;
      buyBtnContainer.appendChild(container);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initStickyBuyBar();
        sanitizeSizeGuideUI();
        initConciergeAdvisorAction();
      });
    } else {
      initStickyBuyBar();
      sanitizeSizeGuideUI();
      initConciergeAdvisorAction();
    }
  })();
</script>
