{% doc %}
  Cart Products
  Renders the cart products list or empty cart state.

  Renders the cart products list or empty cart state.

  @param {boolean} [force_empty] - Force render empty cart state
  @param {block} [block] - The block object providing settings and editor attributes.
  @param {string} [context] - Render context — pass `'drawer'` when rendered inside the cart drawer to enable drawer-specific styles.

  @example
  {% render 'cart-products', force_empty: true %}
{% enddoc %}

{% render 'cart-typography-styles' %}
{% render 'price-styles' %}

{% liquid
  assign block_settings = block.settings
%}

{%- if block_settings.input_style == 'custom' -%}
  {%- capture custom_style -%}
    {%- render 'input-custom-styles', block_settings: block_settings -%}
    --style-border-width-inputs: {{ block_settings.border_width }}px;
    --style-border-radius-inputs: {{ block_settings.border_radius }}px;
    --style-border-radius-buttons-primary: {{ block_settings.border_radius }}px;
    --style-border-radius-buttons-secondary: {{ block_settings.border_radius }}px;
  {%- endcapture -%}
{%- endif -%}

<script
  src="{{ 'component-cart-items.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'component-cart-quantity-selector.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'volume-pricing-info.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'text-component-shimmer-styles' %}

<div
  {{ block.shopify_attributes }}
  class="cart-items__wrapper{% if context == 'drawer' and cart.empty? or force_empty %} cart-items__wrapper--drawer-empty{% endif %}"
  {% if context == 'drawer' and cart.empty? or force_empty %}
    data-cart-drawer-empty
  {% endif %}
  style="
    {%- if settings.product_title_case == 'uppercase' -%}--product-title-case: uppercase;{%- endif -%}
    {{- custom_style -}}
  "
>
  {% liquid
  assign physical_items_count = 0
  assign cert_items_count = 0
  assign orphan_cert_keys = ''
  assign claimed_parent_ids = ''

  for item in cart.items
    assign is_checkcheck = false
    if item.variant_id == 57721101779110 or item.product.handle == 'official-checkcheck-certificate-of-authenticity' or item.title contains 'CheckCheck Certificate'
      assign is_checkcheck = true
    endif
    if is_checkcheck == false
      assign physical_items_count = physical_items_count | plus: item.quantity
    endif
  endfor

  for item in cart.items
    assign is_checkcheck = false
    if item.variant_id == 57721101779110 or item.product.handle == 'official-checkcheck-certificate-of-authenticity' or item.title contains 'CheckCheck Certificate'
      assign is_checkcheck = true
    endif

    if is_checkcheck
      assign cert_items_count = cert_items_count | plus: item.quantity
      if physical_items_count == 0
        assign orphan_cert_keys = orphan_cert_keys | append: item.key | append: ','
      else
        assign matched_parent = false
        assign cert_parent_id = item.properties['_parent_id'] | default: ''
        assign cert_for = item.properties['Certified For'] | default: ''

        if cert_parent_id != blank or cert_for != blank
          for p_item in cart.items
            assign p_is_cert = false
            if p_item.variant_id == 57721101779110 or p_item.product.handle == 'official-checkcheck-certificate-of-authenticity' or p_item.title contains 'CheckCheck Certificate'
              assign p_is_cert = true
            endif
            if p_is_cert == false
              assign p_vid = p_item.variant_id | append: ''
              if cert_parent_id == p_vid or cert_for contains p_item.product.title
                assign claim_token = ',' | append: p_vid | append: ','
                unless claimed_parent_ids contains claim_token
                  assign matched_parent = true
                  assign claimed_parent_ids = claimed_parent_ids | append: claim_token
                  break
                endunless
              endif
            endif
          endfor
        endif

        if matched_parent == false
          assign orphan_cert_keys = orphan_cert_keys | append: item.key | append: ','
        endif
      endif
    endif
  endfor
%}

{% if orphan_cert_keys != blank %}
  <script>
    (async function autoPurgeOrphanCertificates() {
      try {
        const orphanKeys = '{{ orphan_cert_keys }}'.split(',').filter(Boolean);
        if (orphanKeys.length > 0) {
          const updates = {};
          orphanKeys.forEach(k => { updates[k] = 0; });
          const res = await fetch('/cart/update.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ updates })
          });
          if (res.ok) {
            window.location.reload();
          }
        }
      } catch (err) {
        console.error('Failed to auto-purge orphan certs:', err);
      }
    })();
  </script>
{% endif %}
{% if cart.empty? or force_empty or physical_items_count == 0 %}
  {% if cert_items_count > 0 and physical_items_count == 0 %}
    <script>
      (function(){
        try {
          sessionStorage.setItem('cart-count', JSON.stringify({ value: '0', timestamp: Date.now() }));
        } catch (_) {}
        fetch('/cart/clear.js', { method: 'POST' }).then(() => {
          if (typeof reloadCartSections === 'function') {
            reloadCartSections({ items: [] });
          } else {
            window.location.reload();
          }
        });
      })();
    </script>
  {% endif %}
    {%- if shop.customer_accounts_enabled and customer == null -%}
      <p>
        {{ 'actions.log_in_html' | t: link: routes.account_login_url }}
      </p>
    {%- endif -%}

    <a
      class="button cart-items__empty-button"
      href="{{ settings.empty_cart_button_link | default: routes.all_products_collection_url }}"
    >
      <span class="button-text">
        {{ 'actions.continue_shopping' | t }}
      </span>
    </a>
  {%- else -%}
    <span
      class="visually-hidden"
      ref="cartItemCount"
      aria-hidden="true"
    >
      {{- physical_items_count -}}
    </span>
    <form
      action="{{ routes.cart_url }}"
      class="cart-form"
      id="cart-form"
      method="post"
    >
      <div
        class="cart-items spacing-style{% if block_settings.dividers %} cart-items--dividers{% endif %}"
        style="{% render 'spacing-style', settings: block_settings %} --cart-items-gap:{{ block_settings.gap | append: "px" }};"
      >
        <table
          class="cart-items__table"
          role="table"
        >
          <caption
            class="visually-hidden"
            role="caption"
          >
            {{ 'content.cart_total' | t }}
            <span
              ><bdi>{{ cart.total_price | money_with_currency | replace: '.00', '' }}</bdi></span
            >
          </caption>

          <thead
            class="visually-hidden"
            role="rowgroup"
          >
            <tr
              role="row"
              class="cart-items__table-row"
            >
              <th
                id="productImage"
                scope="col"
                role="columnheader"
              >
                {{ 'content.product_image' | t }}
              </th>
              <th
                id="productInformation"
                scope="col"
                role="columnheader"
              >
                {{ 'content.product_information' | t }}
              </th>
              <th
                id="quantity"
                scope="col"
                role="columnheader"
              >
                {{ 'content.quantity' | t }}
              </th>
              <th
                id="productTotal"
                scope="col"
                role="columnheader"
              >
                {{ 'content.product_total' | t }}
              </th>
            </tr>
          </thead>

          <tbody role="rowgroup">
            {% for item in cart.items %}
              {%- liquid
                assign is_checkcheck = false
                if item.variant_id == 57721101779110 or item.product.handle == 'official-checkcheck-certificate-of-authenticity' or item.title contains 'CheckCheck Certificate'
                  assign is_checkcheck = true
                endif
              -%}
              {% if is_checkcheck %}
                {% continue %}
              {% endif %}
              {%- liquid
                assign attached_cert = null
                for other_item in cart.items
                  if other_item.variant_id == 57721101779110 or other_item.product.handle == 'official-checkcheck-certificate-of-authenticity' or other_item.title contains 'CheckCheck Certificate'
                    assign parent_id = other_item.properties['_parent_id'] | default: ''
                    assign cert_for = other_item.properties['Certified For'] | default: ''
                    assign cur_variant_id = item.variant_id | append: ''
                    if parent_id == cur_variant_id or cert_for contains item.product.title
                      assign attached_cert = other_item
                      break
                    endif
                  endif
                endfor
              -%}
              <tr
                id="CartItem-{{ item.key }}"
                role="row"
                class="cart-items__table-row{% if item.parent_relationship.parent != null %} cart-items__nested-line{% endif %}{% if context == 'drawer' %}{% unless item.unit_price_measurement %} cart-items__table-row--full-width-variants{% endunless %}{% endif %}"
                ref="cartItemRows[]"
                data-parent-key="{{ item.parent_relationship.parent.key }}"
                data-key="{{ item.key }}"
                data-variant-id="{{ item.variant_id }}"
                data-line-index="{{ item.index }}"
                data-line="{{ item.index }}"
                {% if attached_cert != null %}
                  data-attached-cert-key="{{ attached_cert.key }}"
                {% endif %}
              >
                <td
                  class="cart-items__media"
                  role="cell"
                  headers="productImage"
                >
                  {% if item.image -%}
                    {% liquid
                      assign ratio = 1
                      assign border_opacity = settings.cart_thumbnail_border_opacity | divided_by: 100.0
                      assign border_override = '--border-width: [cart_thumbnail_border_width]px; --border-style: [cart_thumbnail_border_style]; --border-color: rgb(var(--color-border-rgb) / [cart_thumbnail_border_opacity]); --border-radius: [cart_thumbnail_border_radius]px;' | replace: '[cart_thumbnail_border_width]', settings.cart_thumbnail_border_width | replace: '[cart_thumbnail_border_style]', settings.cart_thumbnail_border | replace: '[cart_thumbnail_border_opacity]', border_opacity | replace: '[cart_thumbnail_border_radius]', settings.cart_thumbnail_border_radius

                      if settings.cart_thumbnail_border_radius > 0
                        assign border_override = border_override | append: ' overflow: hidden;'
                      endif
                      if block_settings.image_ratio == 'portrait'
                        assign ratio = 0.8
                      elsif block_settings.image_ratio == 'adapt'
                        assign ratio = item.image.aspect_ratio
                      endif
                    %}
                    <a
                        href="{{ item.url }}"
                        class="cart-items__media-container"
                        style="--ratio:{{ ratio }};"
                      >
                        {%- liquid
                          echo item.image | image_url: width: 250 | image_tag: class: 'cart-items__media-image border-style', style: border_override
                        -%}
                      </a>
                  {%- endif %}
                </td>
                <td
                  class="cart-items__details cart-primary-typography"
                  role="cell"
                  headers="productInformation"
                >
                  <div class="cart-items__product-info">
                    {%- liquid
                      assign cart_disclosure_unique_id = 'page-' | append: item.index
                      if context == 'drawer'
                        assign cart_disclosure_unique_id = 'drawer-' | append: item.index
                      endif
                    -%}
                    <div class="cart-items__title-row">
                      <a
                        href="{{ item.url }}"
                        class="cart-items__title"
                        {% if item.parent_relationship.parent != null %}
                          aria-label="{{ 'accessibility.nested_product' | t: product_title: item.product.title, parent_title: item.parent_relationship.parent.title | escape }}"
                        {% endif %}
                      >
                        {{- item.product.title -}}
                      </a>
                      {%- render 'cart-disclosure-tooltip',
                        product: item.product,
                        unique_id: cart_disclosure_unique_id,
                        mode: 'trigger'
                      -%}
                    </div>
                    {% if item.product.vendor and block_settings.vendor %}
                      <p>
                        <bdi>{{ item.product.vendor }}</bdi>
                      </p>
                    {% endif %}

                    {%- if item.item_components.size != 0 -%}
                      <ul class="cart-items__bundle list-unstyled">
                        {%- for component in item.item_components -%}
                          <li>
                            {{- component.title -}}
                            {%- if component.quantity > 1 -%}
                              <span> × {{ component.quantity }}</span>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>

                  <div class="cart-items__variants-wrapper">
                    {%- if item.product.has_only_default_variant == false
                      or item.properties.size != 0
                      or item.selling_plan_allocation != null
                    -%}
                      {%- if item.product.has_only_default_variant == false and item.item_components.size == 0 -%}
                        <dl class="cart-items__variants">
                          {%- for option in item.options_with_values -%}
                            <div class="cart-items__variant">
                              <dt class="visually-hidden">{{ option.name }}:</dt>
                              <dd>
                                {{- option.value -}}
                                {%- if forloop.last != true %},&nbsp;{% endif -%}
                              </dd>
                            </div>
                          {%- endfor -%}
                        </dl>
                      {%- endif -%}

                      {%- assign it_type = item.product.type | downcase -%}
                      {%- assign it_tags = item.product.tags | join: ',' | downcase -%}
                      {%- if it_type contains 'footwear' or it_type contains 'shoes' or it_tags contains 'footwear' or it_tags contains 'sneakers' -%}
                        {%- if attached_cert != null -%}
                          <div class="ra-attached-cert-box" style="margin: 0.45rem 0 0.35rem 0; padding: 0.45rem 0.65rem; background: #faf9f6; border: 1px solid rgba(16, 185, 129, 0.35); border-left: 3px solid #10b981; border-radius: 4px; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; transition: opacity 0.2s ease;">
                            <div style="display: flex; align-items: center; gap: 0.45rem; min-width: 0;">
                              <svg width="14" height="14" viewBox="0 0 20 20" fill="none" style="flex-shrink: 0;"><path d="M10 2L4 5v5c0 4.5 2.5 8.7 6 10 3.5-1.3 6-5.5 6-10V5l-6-3z" fill="#10b981"/><path d="M7 10l2 2 4-4" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                              <div style="min-width: 0; line-height: 1.25;">
                                <div style="font-size: 0.72rem; font-weight: 700; color: #111827; letter-spacing: -0.01em;">
                                  CheckCheck® Certificate <span style="color: #059669; font-weight: 600;">(+₹699{% if attached_cert.quantity > 1 %} × {{ attached_cert.quantity }}{% endif %})</span>
                                </div>
                                <div style="font-size: 0.625rem; color: #6b7280;">Physical Serialized Tag &amp; Digital COA</div>
                              </div>
                            </div>
                            <button type="button" class="ra-remove-cert-btn" onclick="event.stopPropagation(); removeAttachedCert('{{ attached_cert.key }}', '{{ item.key }}', this, event)" style="display: inline-flex; align-items: center; gap: 3px; background: none; border: none; padding: 2px 4px; font-size: 0.6875rem; color: #9ca3af; cursor: pointer; text-decoration: underline;" title="Remove certificate from this product">
                              Remove
                            </button>
                          </div>
                        {%- else -%}
                          <div class="ra-add-cert-prompt" style="margin: 0.35rem 0 0.25rem 0; transition: opacity 0.2s ease;">
                            <button type="button" class="ra-add-cert-btn" data-variant-id="{{ item.variant_id }}" data-product-title="{{ item.product.title | escape }}" data-quantity="{{ item.quantity }}" onclick="event.stopPropagation(); addCertToProduct(this, null, null, event)" style="display: inline-flex; align-items: center; gap: 4px; background: none; border: 1px dashed rgba(16, 185, 129, 0.45); border-radius: 4px; padding: 3px 7px; font-size: 0.6875rem; font-weight: 600; color: #047857; cursor: pointer; transition: all 0.2s ease;">
                              <svg width="11" height="11" viewBox="0 0 20 20" fill="none"><path d="M10 2L4 5v5c0 4.5 2.5 8.7 6 10 3.5-1.3 6-5.5 6-10V5l-6-3z" stroke="#10b981" stroke-width="2" fill="rgba(16,185,129,0.15)"/><path d="M10 7v6m-3-3h6" stroke="#10b981" stroke-width="2" stroke-linecap="round"/></svg>
                              <span>+ Add CheckCheck Certificate (+₹699)</span>
                            </button>
                          </div>
                        {%- endif -%}
                      {%- endif -%}

                      {%- liquid
                        assign has_visible_properties = false
                        for property in item.properties
                          assign property_first_char = property.first | slice: 0
                          if property.last != blank and property_first_char != '_'
                            assign has_visible_properties = true
                            break
                          endif
                        endfor
                      -%}
                      {%- if has_visible_properties -%}
                        <dl class="cart-items__properties">
                          {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' and property.first != 'Authentication' and property.first != 'Certified For' -%}
                              <div class="cart-items__property">
                                <dt>{{ property.first }}:</dt>
                                <dd>
                                  {%- if property.last contains '/uploads/' -%}
                                    <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
                                  {%- else -%}
                                    {{ property.last }}
                                  {%- endif -%}
                                </dd>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </dl>
                      {%- endif -%}

                      {%- if item.selling_plan_allocation -%}
                        <p>{{ item.selling_plan_allocation.selling_plan.name }}</p>
                      {%- endif -%}

                      {%- if item.line_level_discount_allocations.size > 0 -%}
                        <ul
                          class="list-unstyled"
                          role="list"
                        >
                          {%- for discount in item.line_level_discount_allocations -%}
                            <li>
                              <bdi>{{ discount.discount_application.title | escape }}</bdi>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    {%- endif -%}
                  </div>

                  <div class="cart-items__unit-price-wrapper">
                    <div>
                      {% if item.original_price != item.final_price %}
                        <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
                        <span
                          ><bdi>{{ item.final_price | money_without_trailing_zeros | replace: '.00', '' }}</bdi></span
                        >
                        <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
                        <s class="compare-at-price">
                          {% if item.variant.compare_at_price > item.original_price %}
                            <bdi>{{ item.variant.compare_at_price | money_without_trailing_zeros | replace: '.00', '' }}</bdi>
                          {% else %}
                            <bdi>{{ item.original_price | money_without_trailing_zeros | replace: '.00', '' }}</bdi>
                          {% endif %}
                        </s>
                      {% else %}
                        {% if item.variant.compare_at_price > item.original_price %}
                          <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
                        {% else %}
                          <span class="visually-hidden">{{ 'content.price' | t }}</span>
                        {% endif %}

                        <span
                          ><bdi>{{ item.original_price | money_without_trailing_zeros | replace: '.00', '' }}</bdi></span
                        >

                        {% if item.variant.compare_at_price > item.original_price %}
                          <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
                          <s class="compare-at-price"
                            ><bdi>{{ item.variant.compare_at_price | money_without_trailing_zeros | replace: '.00', '' }}</bdi></s
                          >
                        {% endif %}
                      {% endif %}
                    </div>
                  </div>
                </td>
                <td
                  class="cart-items__quantity"
                  role="cell"
                  headers="quantity"
                >
                  {% # Here I want to pass some arguments to the quantity block so it knows which value should the input be set to. Though quantity block could be a snippet instead %}
                  {% assign can_update_quantity = item.instructions.can_update_quantity
                    | default: true, allow_false: true
                  %}
                  <div class="cart-items__quantity-controls">
                    {% render 'volume-pricing-info',
                      variant: item.variant,
                      unique_id: item.index,
                      quantity: item.quantity
                    %}

                    {% render 'quantity-selector',
                      product: item.product,
                      variant: item.variant,
                      in_cart_quantity: item.quantity,
                      line_index: item.index,
                      class: 'cart-primary-typography',
                      can_update_quantity: can_update_quantity
                    %}

                    {% if attached_cert != null %}
                      <button
                        class="button cart-items__remove"
                        type="button"
                        aria-label="{{ 'accessibility.remove_item' | t: title: item.title | escape }}"
                        onclick="event.stopPropagation(); removeProductAndCert('{{ item.key }}', '{{ attached_cert.key }}', event)"
                        title="Remove item and certificate"
                      >
                        {{- 'icon-delete.svg' | inline_asset_content -}}
                        <span class="visually-hidden">{{ 'accessibility.remove' | t }}</span>
                      </button>
                    {% else %}
                      <button
                        class="button cart-items__remove"
                        type="button"
                        aria-label="{{ 'accessibility.remove_item' | t: title: item.title | escape }}"
                        on:click="/onLineItemRemove/{{ item.index | plus: 1 }}"
                        {% assign can_remove = item.instructions.can_remove | default: true, allow_false: true %}
                        {% if can_remove == false %}
                          hidden
                        {% endif %}
                      >
                        {{- 'icon-delete.svg' | inline_asset_content -}}
                        <span class="visually-hidden">{{ 'accessibility.remove' | t }}</span>
                      </button>
                    {% endif %}
                  </div>
                </td>
                <td
                  class="cart-items__error hidden"
                  role="cell"
                  ref="cartItemErrorContainer-{{ item.index | plus: 1 }}"
                  headers="quantity"
                >
                  <div
                    class="cart-item__error"
                    role="alert"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    <small
                      class="cart-item__error-text cart-primary-typography"
                      ref="cartItemError-{{ item.index | plus: 1 }}"
                    ></small>
                  </div>
                </td>
                {%- liquid
                  if settings.currency_code_enabled_cart_items
                    assign price = item.final_line_price | money_with_currency | replace: '.00', ''
                    assign unit_price = item.unit_price | money_with_currency | replace: '.00', ''
                  else
                    assign price = item.final_line_price | money_without_trailing_zeros | replace: '.00', ''
                    assign unit_price = item.unit_price | money_without_trailing_zeros | replace: '.00', ''
                  endif
                -%}
                <td
                  class="cart-items__price cart-secondary-typography"
                  role="cell"
                  headers="productTotal"
                >
                  <text-component value="{{ price | strip_html }}"
                    ><bdi>{{ price }}</bdi></text-component
                  >
                  {%- if item.unit_price_measurement -%}
                    <div class="cart-items__price-unit cart-secondary-typography">
                      {% render 'unit-price', price: unit_price, measurement: item.unit_price_measurement %}
                    </div>
                  {%- endif -%}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        {% for item in cart.items %}
          {%- liquid
            assign cart_disclosure_unique_id = 'page-' | append: item.index
            if context == 'drawer'
              assign cart_disclosure_unique_id = 'drawer-' | append: item.index
            endif
          -%}
          {% render 'cart-disclosure-tooltip',
            product: item.product,
            unique_id: cart_disclosure_unique_id,
            mode: 'dialog'
          %}
        {% endfor %}
      </div>
    </form>
  {%- endif -%}
</div>

{% stylesheet %}
  @keyframes ra-cert-spin {
    to { transform: rotate(360deg); }
  }
  .ra-cert-spinner {
    display: inline-block;
    width: 10px;
    height: 10px;
    border: 1.5px solid rgba(16, 185, 129, 0.25);
    border-top-color: #10b981;
    border-radius: 50%;
    animation: ra-cert-spin 0.65s linear infinite;
    vertical-align: middle;
    flex-shrink: 0;
  }
  .ra-cert-spinner--gray {
    border: 1.5px solid rgba(156, 163, 175, 0.3);
    border-top-color: #6b7280;
  }
  .ra-add-cert-btn *, .ra-remove-cert-btn * {
    pointer-events: none;
  }
  .cart-items {
    --cart-item-media-width-min: 2.5rem;
    --cart-item-media-width-max: 7.5rem;

    container-name: cart-items;
    container-type: inline-size;
    width: 100%;
  }

  .cart-items-disabled {
    pointer-events: none;
  }

