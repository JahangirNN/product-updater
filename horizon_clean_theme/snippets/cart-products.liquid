<script>
  // Event barrier: Prevent clicks on certificate actions from bubbling up to
  // theme-drawer's dialog backdrop click listener (#onBackdropClick).
  if (!window.__raCertGuardInstalled) {
    window.__raCertGuardInstalled = true;
    document.addEventListener('click', function(e) {
      if (e.target && e.target.closest && e.target.closest('.ra-add-cert-btn, .ra-remove-cert-btn, .ra-attached-cert-box, .ra-add-cert-prompt')) {
        e.stopPropagation();
      }
    }, false); // false = bubble phase, allowing the button click handler to run first
  }

  async function syncCartBubbleAndSessionStorage(cartData) {
    try {
      let data = cartData;
      if (!data || !Array.isArray(data.items)) {
        const cartRes = await fetch('/cart.js', {
          credentials: 'same-origin',
          headers: { 'Accept': 'application/json' },
          cache: 'no-store'
        });
        if (cartRes.ok) {
          data = await cartRes.json();
        }
      }

      if (data && Array.isArray(data.items)) {
        const physicalCount = data.items.reduce((sum, it) => {
          const vid = String(it.variant_id || it.id || '');
          const pid = String(it.product_id || '');
          const title = String(it.title || '');
          const handle = String(it.handle || '');
          const isCert = vid === '57721101779110' ||
                         pid === '15886266794150' ||
                         title.includes('CheckCheck') ||
                         handle === 'checkcheck-certificate' ||
                         handle === 'official-checkcheck-certificate-of-authenticity';
          return isCert ? sum : sum + (it.quantity || 0);
        }, 0);

        // Authoritatively update sessionStorage before any page reload or navigation
        sessionStorage.setItem(
          'cart-count',
          JSON.stringify({ value: String(physicalCount), timestamp: Date.now() })
        );

        // Synchronize in-page DOM bubble elements
        document.querySelectorAll('.cart-count, [ref="cartItemCount"]').forEach(el => {
          el.textContent = physicalCount;
        });
        document.querySelectorAll('[ref="cartBubbleCount"], [data-testid="cart-bubble"], .cart-bubble__text-count').forEach(el => {
          el.textContent = physicalCount < 100 ? String(physicalCount) : '';
          el.classList.toggle('hidden', physicalCount === 0);
        });
        document.querySelectorAll('[ref="cartBubble"], .cart-bubble').forEach(el => {
          el.classList.toggle('visually-hidden', physicalCount === 0);
        });

        // Trigger custom element update if available
        document.querySelectorAll('cart-icon').forEach(ci => {
          if (typeof ci.renderCartBubble === 'function') {
            ci.renderCartBubble(physicalCount, false);
          }
        });

        return physicalCount;
      }
    } catch (e) {
      console.warn('Failed to sync cart count to sessionStorage:', e);
      try {
        sessionStorage.removeItem('cart-count');
      } catch (_) {}
    }
    return null;
  }

  function getCartSectionIds() {
    const sectionIds = new Set(['cart-drawer-section']);
    document.querySelectorAll('cart-items-component').forEach(comp => {
      if (comp.dataset && comp.dataset.sectionId) sectionIds.add(comp.dataset.sectionId);
    });
    return Array.from(sectionIds).join(',');
  }

  async function reloadCartSections(cartData) {
    // 1. Authoritatively sync sessionStorage and DOM bubble before reload or DOM replacement
    await syncCartBubbleAndSessionStorage(cartData);

    // 2. Full page reload on cart page
    if (window.location.pathname.endsWith('/cart') || window.location.pathname.endsWith('/cart/')) {
      window.location.reload();
      return;
    }

    // 3. Drawer replacement with state preservation
    const drawer = document.querySelector('theme-drawer#cart-drawer');
    const wasDrawerOpen = drawer && (drawer.hasAttribute('open') || drawer.isOpen);

    try {
      let drawerHtml = '';
      if (cartData && cartData.sections && cartData.sections['cart-drawer-section']) {
        drawerHtml = cartData.sections['cart-drawer-section'];
      } else {
        const res = await fetch('/?sections=cart-drawer-section&_t=' + Date.now(), {
          headers: { 'Accept': 'application/json' },
          cache: 'no-store'
        });
        if (res.ok) {
          const json = await res.json();
          drawerHtml = json['cart-drawer-section'] || '';
        }
      }

      if (drawerHtml) {
        const doc = new DOMParser().parseFromString(drawerHtml, 'text/html');
        const newItems = doc.querySelector('cart-items-component');
        const currentItems = document.querySelector('#cart-drawer cart-items-component');
        if (newItems && currentItems) {
          currentItems.replaceWith(newItems);
        } else {
          const newInner = doc.querySelector('.cart-drawer__inner');
          const currentInner = document.querySelector('#cart-drawer .cart-drawer__inner');
          if (newInner && currentInner) {
            currentInner.innerHTML = newInner.innerHTML;
          }
        }
        const newHeader = doc.querySelector('.theme-drawer__header');
        const currentHeader = document.querySelector('#cart-drawer .theme-drawer__header');
        if (newHeader && currentHeader) {
          currentHeader.replaceWith(newHeader);
        }
      }

      if (wasDrawerOpen && drawer) {
        if (!drawer.hasAttribute('open')) {
          drawer.setAttribute('open', '');
        }
        const dialog = drawer.querySelector('dialog');
        if (dialog && !dialog.open && typeof dialog.showModal === 'function') {
          try { dialog.showModal(); } catch (_) { dialog.open = true; }
        }
      }
    } catch (e) {
      console.warn('Drawer replacement fallback:', e);
      if (wasDrawerOpen && drawer) {
        drawer.setAttribute('open', '');
      }
    }
  }

  async function removeProductAndCert(itemKey, certKey, evt) {
    if (evt && typeof evt.stopPropagation === 'function') evt.stopPropagation();
    if (window.event && typeof window.event.stopPropagation === 'function') window.event.stopPropagation();
    try {
      const updates = {};
      updates[itemKey] = 0;
      if (certKey) updates[certKey] = 0;
      const sectionIds = getCartSectionIds();
      const res = await fetch('/cart/update.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({
          updates,
          sections: sectionIds,
          sections_url: window.location.pathname
        })
      });
      if (res.ok) {
        let cartData = null;
        try {
          cartData = await res.json();
        } catch (_) {}
        await reloadCartSections(cartData);
      }
    } catch (err) {
      console.error('Failed to remove item and cert:', err);
    }
  }

  async function removeAttachedCert(certKey, parentKey, btn, evt) {
    if (evt && typeof evt.stopPropagation === 'function') evt.stopPropagation();
    if (window.event && typeof window.event.stopPropagation === 'function') window.event.stopPropagation();
    let originalHtml = '';
    const card = btn ? btn.closest('.ra-attached-cert-box') : null;
    try {
      if (btn) {
        originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.style.pointerEvents = 'none';
        btn.innerHTML = '<span class="ra-cert-spinner ra-cert-spinner--gray"></span> <span style="font-size: 0.65rem; color: #9ca3af;">Removing...</span>';
        if (card) card.style.opacity = '0.55';
      }
      const updates = {};
      updates[certKey] = 0;
      const sectionIds = getCartSectionIds();
      const res = await fetch('/cart/update.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({
          updates,
          sections: sectionIds,
          sections_url: window.location.pathname
        })
      });
      if (res.ok) {
        let cartData = null;
        try {
          cartData = await res.json();
        } catch (_) {}
        await reloadCartSections(cartData);
      } else {
        throw new Error('Remove certificate failed');
      }
    } catch (err) {
      console.error('Failed to remove cert:', err);
      if (btn) {
        btn.disabled = false;
        btn.style.pointerEvents = '';
        btn.innerHTML = originalHtml || 'Remove';
        if (card) card.style.opacity = '1';
      }
    }
  }

  async function addCertToProduct(target, titleArg, qtyArg, evt) {
    if (evt && typeof evt.stopPropagation === 'function') evt.stopPropagation();
    if (window.event && typeof window.event.stopPropagation === 'function') window.event.stopPropagation();
    let btnElement = null;
    let originalHtml = '';
    let promptContainer = null;
    try {
      let variantId, productTitle, quantity;
      if (target instanceof Element) {
        btnElement = target;
        if (target.disabled || target.dataset.adding) return;
        target.dataset.adding = 'true';
        target.disabled = true;
        target.style.pointerEvents = 'none';
        originalHtml = target.innerHTML;
        target.innerHTML = '<span class="ra-cert-spinner"></span> <span>Adding Certificate...</span>';
        target.style.borderColor = 'rgba(16, 185, 129, 0.65)';
        target.style.background = 'rgba(16, 185, 129, 0.05)';
        promptContainer = target.closest('.ra-add-cert-prompt');
        if (promptContainer) promptContainer.style.opacity = '0.85';

        variantId = target.dataset.variantId;
        productTitle = target.dataset.productTitle;
        quantity = parseInt(target.dataset.quantity || '1', 10);
      } else {
        variantId = target;
        productTitle = titleArg;
        quantity = qtyArg || 1;
      }

      // Check if a certificate already exists in the cart for this variantId before adding
      try {
        const checkRes = await fetch('/cart.js');
        if (checkRes.ok) {
          const currentCart = await checkRes.json();
          const alreadyHasCert = currentCart.items.some(it => {
            const isCert = it.variant_id == 57721101779110 || (it.title && it.title.includes('CheckCheck'));
            const pId = it.properties && (it.properties['_parent_id'] || it.properties['parent_id']);
            return isCert && String(pId) === String(variantId);
          });
          if (alreadyHasCert) {
            await reloadCartSections(currentCart);
            return;
          }
        }
      } catch (_) {}

      const sectionIds = getCartSectionIds();
      const payload = {
        items: [
          {
            id: 57721101779110,
            quantity: quantity || 1,
            properties: {
              'Certified For': productTitle,
              'Authentication': 'CheckCheck Certified (+₹699)',
              '_parent_id': String(variantId)
            }
          }
        ]
      };
      if (sectionIds) {
        payload.sections = sectionIds;
        payload.sections_url = window.location.pathname;
      }
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify(payload)
      });
      if (res.ok) {
        let cartData = null;
        try {
          cartData = await res.json();
        } catch (_) {}
        await reloadCartSections(cartData);
      } else {
        throw new Error('Add certificate failed');
      }
    } catch (err) {
      console.error('Failed to add cert:', err);
      if (btnElement) {
        btnElement.disabled = false;
        btnElement.style.pointerEvents = '';
        btnElement.style.borderColor = '';
        btnElement.style.background = '';
        btnElement.innerHTML = originalHtml;
        delete btnElement.dataset.adding;
        if (promptContainer) promptContainer.style.opacity = '1';
      }
    }
  }

  window.autoReconcileCartCertificates = async function(cartData) {
    try {
      if (!cartData || !Array.isArray(cartData.items)) {
        const res = await fetch('/cart.js');
        if (!res.ok) return false;
        cartData = await res.json();
      }
      if (!cartData || !Array.isArray(cartData.items)) return false;

      const isCert = (item) => {
        const vid = String(item.variant_id || item.id || '');
        const pid = String(item.product_id || '');
        const title = String(item.title || '');
        const handle = String(item.handle || '');
        return vid === '57721101779110' ||
               pid === '15886266794150' ||
               title.includes('CheckCheck') ||
               handle === 'checkcheck-certificate' ||
               handle === 'official-checkcheck-certificate-of-authenticity';
      };

      const physicalItems = cartData.items.filter(it => !isCert(it));
      const certItems = cartData.items.filter(it => isCert(it));

      // Case 1: No physical items left -> purge all certificates!
      if (physicalItems.length === 0 && certItems.length > 0) {
        const updates = {};
        certItems.forEach(c => { updates[c.key] = 0; });
        const res = await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ updates })
        });
        if (res.ok) {
          const updated = await res.json();
          await reloadCartSections(updated);
          return true;
        }
        return false;
      }

      // Case 2: Ensure each certificate has a valid matching physical parent and no duplicates
      const updates = {};
      let needsUpdate = false;
      const claimedPhysicalVariants = new Set();

      for (const cert of certItems) {
        const parentId = cert.properties ? String(cert.properties['_parent_id'] || cert.properties['parent_id'] || '').trim() : '';
        const certFor = cert.properties ? String(cert.properties['Certified For'] || '').trim() : '';

        let matchedPhysical = null;
        if (parentId) {
          matchedPhysical = physicalItems.find(p => String(p.variant_id) === parentId);
        }
        if (!matchedPhysical && certFor) {
          matchedPhysical = physicalItems.find(p => {
            const pTitle = p.product_title || p.title || '';
            return pTitle && (certFor.includes(pTitle) || pTitle.includes(certFor));
          });
        }

        // Orphan certificate (no matching physical product)
        if (!matchedPhysical) {
          updates[cert.key] = 0;
          needsUpdate = true;
          continue;
        }

        // Duplicate certificate for the same physical item
        const pKey = String(matchedPhysical.variant_id);
        if (claimedPhysicalVariants.has(pKey)) {
          updates[cert.key] = 0;
          needsUpdate = true;
          continue;
        }
        claimedPhysicalVariants.add(pKey);

        // Synchronize quantity to match physical item
        if (cert.quantity !== matchedPhysical.quantity) {
          updates[cert.key] = matchedPhysical.quantity;
          needsUpdate = true;
        }
      }

      if (needsUpdate) {
        const sectionIds = getCartSectionIds();
        const res = await fetch('/cart/update.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({
            updates,
            sections: sectionIds,
            sections_url: window.location.pathname
          })
        });
        if (res.ok) {
          let updated = null;
          try { updated = await res.json(); } catch (_) {}
          await reloadCartSections(updated);
          return true;
        }
      }
      return false;
    } catch (e) {
      console.warn('Auto reconcile error:', e);
      return false;
    }
  };

  // Run reconciliation automatically on cart load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      window.autoReconcileCartCertificates();
    });
  } else {
    window.autoReconcileCartCertificates();
  }
</script>
