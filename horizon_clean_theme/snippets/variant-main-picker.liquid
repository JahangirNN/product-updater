{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% liquid
  # Custom styling applies to:
  #   - dropdowns + buttons when variant_style_class == 'custom' (unselected colors)
  #   - buttons only when selected_variant_style_class == 'custom' (selected colors)
  assign has_custom_variant_buttons = false
  if block_settings.variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  if block_settings.variant_style == 'buttons' and block_settings.selected_variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  assign fieldset_index = 0
%}

{% unless product_resource.has_only_default_variant %}
  {% if has_custom_variant_buttons %}
    {% render 'variant-button-custom-styles', block_settings: block_settings, block_id: block.id %}
  {% endif %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}{% if has_custom_variant_buttons %} variant-picker--custom-{{ block.id }}{% endif %}"
    style="
      {% render 'spacing-style', settings: block_settings %}
       {% if block_settings.option_label_text_color != blank %}
        --variant-option-label-color: rgba({{ block_settings.option_label_text_color.rgba }});
        --variant-option-label-color-subdued: rgba({{ block_settings.option_label_text_color.rgb }} / var(--opacity-subdued-text));
      {% endif %}
    "
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-product-handle="{{ product_resource.handle }}"
    data-product-title="{{ product_resource.title | escape }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style | default: 'buttons'
          assign opt_name_lower = product_option.name | downcase
          assign is_color_option = false
          if opt_name_lower contains 'color' or opt_name_lower contains 'colour' or opt_name_lower contains 'shade' or swatch_count > 0
            assign is_color_option = true
          endif

          # Always show swatches with pictures for color options if show_swatches is true or default
          if is_color_option
            if block_settings.variant_style == 'dropdowns'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          assign swatch_opt_key = 'option' | append: product_option.position

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif
        -%}

        {%- if product_option.values.size == 1 and variant_style != 'swatch' -%}
          <!-- Single Variant: Show formatted variant badge / pill rather than naked text -->
          {%- liquid
            assign single_val = product_option.selected_value | default: product_option.values.first
            assign single_var_img = product_resource.selected_or_first_available_variant.featured_media | default: product_resource.featured_media
          -%}
          <div class="variant-option variant-option--pdp-single" data-testid="variant-option-single">
            <span class="variant-option__single-label">{{ product_option.name | escape }}:</span>
            {% if is_color_option and single_var_img != blank %}
              <div class="variant-option__single-swatch-badge">
                <img src="{{ single_var_img | image_url: width: 56, height: 56, crop: 'center' }}" alt="{{ single_val | escape }}" class="variant-option__single-swatch-img" width="22" height="22" />
                <span class="variant-option__swatch-value" data-testid="variant-option-single-value">{{ single_val | escape }}</span>
              </div>
            {% else %}
              <span class="variant-option__single-pill" data-testid="variant-option-single-value">{{ single_val | escape }}</span>
            {% endif %}
          </div>
        {%- elsif variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            <legend>
              {{ product_option.name | escape }}:
              <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
            </legend>
            {%- for product_option_value in product_option.values -%}
              {% liquid
                assign matched_var = nil
                for v in product_resource.variants
                  if v[swatch_opt_key] == product_option_value.name or v.options contains product_option_value.name
                    assign matched_var = v
                    if v.available
                      break
                    endif
                  endif
                endfor
                if matched_var == nil
                  assign matched_var = product_option_value.variant
                endif
              %}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}
              <label
                class="variant-option__button-label{% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
              >
                <input
                  type="radio"
                  name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                  value="{{ product_option_value | escape }}"
                  aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                  {% if product_option_value.available == false %}
                    aria-disabled="true"
                    disabled
                  {% endif %}
                  data-previous-checked="false"
                  data-fieldset-index="{{ fieldset_index }}"
                  data-input-index="{{ forloop.index0 }}"
                  data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                  data-option-name="{{ product_option.name | escape }}"
                  data-option-value-id="{{ product_option_value.id }}"
                  data-option-available="{{ product_option_value.available }}"
                  data-connected-product-url="{{ product_option_value.product_url }}"
                  {% if matched_var %}
                    data-variant-id="{{ matched_var.id }}"
                    data-variant-price="{{ matched_var.price | money_without_trailing_zeros | replace: '.00', '' }}"
                    data-variant-price-raw="{{ matched_var.price }}"
                    data-variant-compare-price="{% if matched_var.compare_at_price > matched_var.price %}{{ matched_var.compare_at_price | money_without_trailing_zeros | replace: '.00', '' }}{% endif %}"
                    data-variant-compare-raw="{{ matched_var.compare_at_price | default: 0 }}"
                  {% elsif product_option_value.variant.id %}
                    data-variant-id="{{ product_option_value.variant.id }}"
                  {% endif %}
                  {% if product_option_value.selected %}
                    data-current-checked="true"
                    checked
                  {% else %}
                    data-current-checked="false"
                  {% endif %}
                >
                {% if variant_style == 'swatch' %}
                  {% liquid
                    # Resolve featured image for this color value
                    assign matched_var = nil
                    for v in product_resource.variants
                      if v[swatch_opt_key] == product_option_value.name or v.options contains product_option_value.name
                        assign matched_var = v
                        if v.available
                          break
                        endif
                      endif
                    endfor

                    assign featured_media = matched_var.featured_media | default: matched_var.featured_image | default: product_option_value.variant.featured_media
                    if featured_media == blank and product_option_value.product_url
                      assign featured_media = product_option_value.variant.product.featured_media
                    endif
                    if featured_media == blank
                      assign featured_media = product_resource.featured_media
                    endif
                  %}

                  {%- if featured_media != blank -%}
                    <span
                      class="swatch swatch--variant-image swatch--unscaled"
                      style="--swatch-background: url('{{ featured_media | image_url: width: 120 }}');"
                      title="{{ product_option_value.name | escape }}"
                    ></span>
                  {%- else -%}
                    {% render 'swatch',
                      swatch: product_option_value.swatch,
                      variant_image: featured_media,
                      mode: 'unscaled'
                    %}
                  {%- endif -%}
                {% else %}
                  {% if product_option_value.available == true %}
                    <span
                      class="variant-option__button-label__pill"
                      data-key="variant-option-pill"
                    ></span>
                  {% endif %}
                  <span
                    class="variant-option__button-label__text"
                    data-key="variant-option-text"
                  >
                    {{- product_option_value | escape -}}
                  </span>
                {% endif %}
                {% render 'strikethrough-variant', product_option: product_option_value %}
              </label>
            {%- endfor -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.65 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          <div class="variant-option variant-option--dropdowns">
            <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret"
                viewBox="0 0 10 6"
              >
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/luxury-variants+json" id="LuxuryProductVariantsData-{{ product_resource.id }}">
        [
          {%- for variant in product_resource.variants -%}
            {
              "id": {{ variant.id }},
              "title": {{ variant.title | json }},
              "price": {{ variant.price }},
              "formatted_price": "{{ variant.price | money_without_trailing_zeros | replace: '.00', '' }}",
              "compare_at_price": {{ variant.compare_at_price | default: 0 }},
              "formatted_compare_at_price": "{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money_without_trailing_zeros | replace: '.00', '' }}{% endif %}",
              "available": {{ variant.available | json }},
              "options": {{ variant.options | json }},
              "option1": {{ variant.option1 | json }},
              "option2": {{ variant.option2 | json }},
              "option3": {{ variant.option3 | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      </script>
      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>
  </variant-picker>
{% endunless %}

{% render 'swatch-styles' %}
{% render 'variant-picker-styles' %}

<style>
  /* Quiet Luxury PDP Variant Enhancements */
  .variant-option--pdp-single {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.875rem;
    padding: 0.25rem 0;
  }
  .variant-option__single-label {
    font-weight: 600;
    color: #1a1a1a;
    letter-spacing: 0.02em;
  }
  .variant-option__single-swatch-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.65rem 0.25rem 0.35rem;
    background: #f7f6f4;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 20px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #1a1a1a;
  }
  .variant-option__single-swatch-img {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(0, 0, 0, 0.12);
  }
  .variant-option__single-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.65rem;
    background: #f7f6f4;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 3px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #1a1a1a;
  }
  /* Quiet Luxury Sizing Pills (Footwear & Apparel) */
  .variant-option--buttons:not(.variant-option--swatches) {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 0.5rem !important;
    border: none !important;
    padding: 0 !important;
    margin: 0.5rem 0 1rem 0 !important;
  }
  .variant-option--buttons:not(.variant-option--swatches) legend {
    width: 100%;
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #1a1a1a;
  }
  .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label {
    flex: 0 0 auto !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: 62px !important;
    height: 40px !important;
    padding: 0 0.85rem !important;
    background: #ffffff !important;
    border: 1px solid rgba(0, 0, 0, 0.14) !important;
    border-radius: 3px !important;
    font-size: 0.8125rem !important;
    font-weight: 500 !important;
    color: #1a1a1a !important;
    cursor: pointer !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label:hover {
    border-color: #c9a876 !important;
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(201, 168, 118, 0.15) !important;
  }
  .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label:has(input:checked) {
    background: #1a1a1a !important;
    color: #ffffff !important;
    border-color: #1a1a1a !important;
    box-shadow: 0 0 0 1px #1a1a1a, 0 2px 8px rgba(0, 0, 0, 0.15) !important;
  }
  .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label:has(input:checked) .variant-option__button-label__text {
    color: #ffffff !important;
  }
  .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label:has(input[aria-disabled="true"]) {
    background: #fbfbfb !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
    color: #999999 !important;
    cursor: not-allowed !important;
    text-decoration: line-through !important;
    opacity: 0.55 !important;
  }

  /* Quiet Luxury Color Picture Swatches */
  .variant-option--swatches {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 0.65rem !important;
    border: none !important;
    padding: 0 !important;
    margin: 0.5rem 0 1rem 0 !important;
  }
  .variant-option--swatches legend {
    width: 100%;
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #1a1a1a;
  }
  .variant-option--swatches .variant-option__button-label--has-swatch {
    border-radius: 50% !important;
    padding: 2px !important;
    border: 1px solid rgba(0, 0, 0, 0.18) !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    cursor: pointer !important;
    background: #ffffff !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
  }
  .variant-option--swatches .variant-option__button-label--has-swatch:hover {
    border-color: #c9a876 !important;
    transform: scale(1.1) !important;
  }
  .variant-option--swatches .variant-option__button-label--has-swatch:has(input:checked) {
    border-color: #1a1a1a !important;
    box-shadow: 0 0 0 2px #c9a876 !important;
    transform: scale(1.05) !important;
  }
  .variant-option--swatches .swatch--variant-image {
    width: 36px !important;
    height: 36px !important;
    border-radius: 50% !important;
    background-size: cover !important;
    background-position: center !important;
    display: block !important;
  }
</style>

<script>
  (function() {
    function updatePDPVariantPrice(variant) {
      if (!variant) return;

      // 1. Format prices
      var priceFormatted = variant.formatted_price || ("Rs. " + Math.round(variant.price / 100).toLocaleString('en-IN'));
      var hasCompare = variant.compare_at_price && variant.compare_at_price > variant.price;
      var compareFormatted = hasCompare ? (variant.formatted_compare_at_price || ("Rs. " + Math.round(variant.compare_at_price / 100).toLocaleString('en-IN'))) : '';

      // 2. Update main price container on PDP
      var priceContainers = document.querySelectorAll('product-price [ref="priceContainer"], product-price, .product-price');
      priceContainers.forEach(function(priceContainer) {
        var priceBdi = priceContainer.querySelector('.price bdi, span.price, bdi');
        if (priceBdi) {
          priceBdi.textContent = priceFormatted;
        }
        var compareEl = priceContainer.querySelector('.compare-at-price');
        if (hasCompare) {
          if (!compareEl) {
            compareEl = document.createElement('span');
            compareEl.className = 'price-item__group price-item--regular compare-at-price';
            compareEl.innerHTML = '<span class="visually-hidden">Regular price&nbsp;</span><bdi></bdi>';
            priceContainer.insertBefore(compareEl, priceContainer.firstChild);
          }
          var compareBdi = compareEl.querySelector('bdi') || compareEl;
          compareBdi.textContent = compareFormatted;
          compareEl.style.display = '';
        } else if (compareEl) {
          compareEl.style.display = 'none';
        }
      });

      // 3. Update Savings Badge
      var savingsRow = document.querySelector('.luxury-pdp-savings-row');
      var savingsBadge = document.querySelector('.luxury-pdp-savings-badge');
      if (hasCompare) {
        var savingsAmount = variant.compare_at_price - variant.price;
        var savingsPercent = Math.round((savingsAmount / variant.compare_at_price) * 100);
        var savingsFormatted = "Rs. " + Math.round(savingsAmount / 100).toLocaleString('en-IN');
        if (savingsBadge) {
          savingsBadge.textContent = 'Save ' + savingsPercent + '% (' + savingsFormatted + ' off)';
        }
        if (savingsRow) savingsRow.style.display = 'flex';
      } else if (savingsRow) {
        savingsRow.style.display = 'none';
      }

      // 4. Update Sticky Quick-Buy Bar
      var stickyPrice = document.querySelector('.luxury-sticky-buy-bar__price');
      if (stickyPrice) {
        stickyPrice.textContent = priceFormatted;
      }
      var stickyVariant = document.querySelector('.luxury-sticky-buy-bar__variant');
      if (stickyVariant && variant.title && variant.title !== 'Default Title') {
        stickyVariant.textContent = '· ' + variant.title;
      }

      // 5. Update form variant ID
      var formVariantInputs = document.querySelectorAll('form[action*="/cart/add"] input[name="id"], .buy-buttons input[name="id"]');
      formVariantInputs.forEach(function(inp) {
        inp.value = variant.id;
      });
    }

    function bindVariantPickerListeners() {
      var vp = document.querySelector('variant-picker');
      if (!vp) return;

      var variants = [];
      var dataScript = vp.querySelector('script[type="application/luxury-variants+json"]') || vp.querySelector('script[id^="LuxuryProductVariantsData-"]') || document.querySelector('script[id^="LuxuryProductVariantsData-"]');
      if (dataScript) {
        try {
          variants = JSON.parse(dataScript.textContent);
        } catch(e) {
          console.warn('Could not parse variants JSON', e);
        }
      }

      vp.addEventListener('change', function(e) {
        var selectedValues = [];
        vp.querySelectorAll('fieldset').forEach(function(fs) {
          var checked = fs.querySelector('input:checked');
          if (checked) selectedValues.push(checked.value.trim());
        });
        vp.querySelectorAll('select').forEach(function(sel) {
          if (sel.value) selectedValues.push(sel.value.trim());
        });

        if (variants.length > 0 && selectedValues.length > 0) {
          var match = variants.find(function(v) {
            return selectedValues.every(function(val) {
              return v.options && v.options.indexOf(val) !== -1;
            });
          });
          if (match) {
            updatePDPVariantPrice(match);
            return;
          }
        }

        var target = e.target;
        if (target && target.dataset && target.dataset.variantPrice) {
          updatePDPVariantPrice({
            id: target.dataset.variantId,
            title: target.value,
            price: parseInt(target.dataset.variantPriceRaw || '0', 10),
            formatted_price: target.dataset.variantPrice,
            compare_at_price: parseInt(target.dataset.variantCompareRaw || '0', 10),
            formatted_compare_at_price: target.dataset.variantComparePrice
          });
        }
      });

      // Hook into Shopify StandardEvents.productSelect for server fetch synchronization
      var closestSection = vp.closest('.shopify-section');
      if (closestSection) {
        closestSection.addEventListener('shopify:events:productSelect', function(ev) {
          if (ev && ev.detail && ev.detail.resource) {
            updatePDPVariantPrice(ev.detail.resource);
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindVariantPickerListeners);
    } else {
      bindVariantPickerListeners();
    }
    document.addEventListener('shopify:section:load', bindVariantPickerListeners);
  })();
</script>
