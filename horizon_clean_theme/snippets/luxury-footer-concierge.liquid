{%- comment -%}
  The Rare Avenue — Quiet Luxury Client Services & Concierge (ADR 0031)
  Provides professional, direct WhatsApp (+91 91069 51947) & Email (Contact@therareavenue.com)
  access with zero intrusive floating icons.
{%- endcomment -%}

<div class="luxury-footer-concierge" data-testid="luxury-footer-concierge">
  <div class="luxury-footer-concierge__grid">
    
    <!-- Column 1: The Maison -->
    <div class="luxury-footer-concierge__col luxury-footer-concierge__col--maison">
      <div class="luxury-footer-concierge__brand-row">
        <span class="luxury-footer-concierge__monogram">THE RARE AVENUE</span>
        <span class="luxury-footer-concierge__badge">CURATIONS</span>
      </div>
      <p class="luxury-footer-concierge__tagline">
        Curating authenticated designer leathercraft, Swiss horology, luxury footwear, and optical collections sourced directly from verified international flagships.
      </p>
      <div class="luxury-footer-concierge__trust-pill">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c9a876" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span>100% Authenticity Guarantee · Verified Partner</span>
      </div>
    </div>

    <!-- Column 2: Client Services & Concierge -->
    <div class="luxury-footer-concierge__col luxury-footer-concierge__col--services">
      <h3 class="luxury-footer-concierge__heading">CLIENT SERVICES & CONCIERGE</h3>
      <p class="luxury-footer-concierge__desc">
        Personal shopping advisors are at your service for sizing guidance, bespoke sourcing, and immediate order support.
      </p>

      <div class="luxury-footer-concierge__actions">
        <!-- Direct WhatsApp Action -->
        <a 
          href="https://wa.me/919106951947?text=Hello%20The%20Rare%20Avenue%2C%20I%20would%20like%20assistance%20with..." 
          class="luxury-footer-concierge__card luxury-footer-concierge__card--wa"
          target="_blank" 
          rel="noopener noreferrer"
          aria-label="Direct WhatsApp Chat with The Rare Avenue"
        >
          <div class="luxury-footer-concierge__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
          </div>
          <div class="luxury-footer-concierge__card-body">
            <span class="luxury-footer-concierge__card-label">WhatsApp Concierge</span>
            <span class="luxury-footer-concierge__card-value">+91 91069 51947</span>
            <span class="luxury-footer-concierge__card-sub">Instant Personal Shopper Access &rarr;</span>
          </div>
        </a>

        <!-- Direct Email Action -->
        <a 
          href="mailto:Contact@therareavenue.com?subject=The%20Rare%20Avenue%20Client%20Inquiry" 
          class="luxury-footer-concierge__card luxury-footer-concierge__card--email"
          aria-label="Email The Rare Avenue Client Care"
        >
          <div class="luxury-footer-concierge__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <div class="luxury-footer-concierge__card-body">
            <span class="luxury-footer-concierge__card-label">Email Client Services</span>
            <span class="luxury-footer-concierge__card-value">Contact@therareavenue.com</span>
            <span class="luxury-footer-concierge__card-sub">Inquiries & Authenticity Inquiries &rarr;</span>
          </div>
        </a>
      </div>

      <div class="luxury-footer-concierge__schedule">
        <span class="luxury-footer-concierge__live-indicator"></span>
        <span>Advisors Available: Mon – Sat · 10:00 AM – 8:00 PM IST</span>
      </div>
    </div>

    <!-- Column 3: Authenticity & Assurance -->
    <div class="luxury-footer-concierge__col luxury-footer-concierge__col--trust">
      <h3 class="luxury-footer-concierge__heading">PROVENANCE & INTEGRITY</h3>
      <ul class="luxury-footer-concierge__points" role="list">
        <li class="luxury-footer-concierge__point">
          <span class="luxury-footer-concierge__bullet">&#9670;</span>
          <div>
            <strong>CheckCheck® Certified</strong>
            <p>Physical & digital multi-point authentication inspection available on select luxury items.</p>
          </div>
        </li>
        <li class="luxury-footer-concierge__point">
          <span class="luxury-footer-concierge__bullet">&#9670;</span>
          <div>
            <strong>100% Genuine Guarantee</strong>
            <p>Every piece is strictly vetted, complete with original manufacturer packaging and serial hallmarks.</p>
          </div>
        </li>
        <li class="luxury-footer-concierge__point">
          <span class="luxury-footer-concierge__bullet">&#9670;</span>
          <div>
            <strong>Complimentary Consultation</strong>
            <p>Connect with our styling desk via WhatsApp for real-time item photos, sizing comparison, and gift curation.</p>
          </div>
        </li>
      </ul>

      <!-- Client Care & Policy Action Links -->
      <div class="luxury-footer-policy-links" style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid rgba(0, 0, 0, 0.08); display: flex; flex-wrap: wrap; gap: 0.65rem 1rem;">
        <button type="button" onclick="openPolicyModal('returns')" class="luxury-footer-policy-btn" style="background: none; border: none; padding: 0; font-size: 0.72rem; color: #1a1a1a; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; font-weight: 500;">
          7-Day Return Policy &rarr;
        </button>
        <button type="button" onclick="openPolicyModal('shipping')" class="luxury-footer-policy-btn" style="background: none; border: none; padding: 0; font-size: 0.72rem; color: #1a1a1a; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; font-weight: 500;">
          Shipping &amp; Duties &rarr;
        </button>
        <button type="button" onclick="openPolicyModal('authenticity')" class="luxury-footer-policy-btn" style="background: none; border: none; padding: 0; font-size: 0.72rem; color: #1a1a1a; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; font-weight: 500;">
          Authenticity Guarantee &rarr;
        </button>
      </div>
    </div>

  </div>
</div>

<!-- ==================== LUXURY CLIENT POLICIES MODAL DIALOG ==================== -->
<div id="ra-policy-modal" class="ra-policy-modal-backdrop" aria-hidden="true" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.65); backdrop-filter: blur(4px); z-index: 9999999; display: none; pointer-events: none; align-items: center; justify-content: center; padding: 1.5rem 1rem; box-sizing: border-box;" onclick="if(event.target===this) closePolicyModal();">
  <div class="ra-policy-modal-card" style="background: #ffffff; border: 1px solid rgba(0, 0, 0, 0.12); max-width: 620px; width: 100%; max-height: calc(100vh - 4rem); overflow-y: auto; padding: 2rem 2.25rem; position: relative; box-shadow: 0 20px 40px rgba(0,0,0,0.25); box-sizing: border-box; font-family: var(--font-body--family, sans-serif);">
    <button type="button" onclick="closePolicyModal()" aria-label="Close dialog" style="position: absolute; top: 1rem; right: 1rem; background: #f5f4ef; border: 1px solid rgba(0,0,0,0.1); border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 1.1rem; line-height: 1; color: #1a1a1a;">&times;</button>
    
    <div id="ra-policy-modal-content">
      <!-- Populated dynamically via JS -->
    </div>
  </div>
</div>

<script>
  var RA_POLICIES = {
    returns: {
      title: "7-DAY LUXURY RETURN & EXCHANGE POLICY",
      content: `
        <p style="font-size: 0.8125rem; line-height: 1.6; color: #444; margin-bottom: 1rem;">
          At <strong>The Rare Avenue</strong>, we stand behind the impeccable quality of our curated luxury catalog. If you are not completely satisfied with your acquisition, you may initiate a return or exchange within <strong>7 days of confirmed delivery</strong>.
        </p>
        <h4 style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: #1a1a1a; margin: 1.25rem 0 0.5rem 0;">Return Eligibility Conditions:</h4>
        <ul style="font-size: 0.8125rem; line-height: 1.6; color: #444; padding-left: 1.25rem; margin: 0 0 1rem 0;">
          <li><strong>General Merchandise:</strong> Items must be completely unworn, unwashed, and in their pristine original condition with all security tags, serial tags, dust bags, and designer packaging attached.</li>
          <li><strong>Cosmetics &amp; Fragrances:</strong> For health and hygiene compliance, beauty and fragrance items can only be returned if they remain in their original unopened condition with the factory cellophane seal intact. Opened or sprayed items cannot be accepted.</li>
          <li><strong>Footwear:</strong> Shoes must be tested only on clean, carpeted surfaces. Soles must be entirely spotless, and the original branded shoebox must be undamaged and returned inside protective outer packaging.</li>
          <li><strong>Watches:</strong> Must include all links, protective plastic coverings, official warranty card/booklet, and presentation box.</li>
        </ul>
        <h4 style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: #1a1a1a; margin: 1.25rem 0 0.5rem 0;">How to Initiate a Return:</h4>
        <p style="font-size: 0.8125rem; line-height: 1.6; color: #444; margin-bottom: 0.5rem;">
          Simply reach out to our Concierge Team via WhatsApp at <a href="https://wa.me/919106951947" target="_blank" style="color: #047857; font-weight: 600;">+91 91069 51947</a> or email <a href="mailto:Contact@therareavenue.com" style="color: #1a1a1a; font-weight: 600;">Contact@therareavenue.com</a> with your Order Number and photos of the item. We will arrange a complimentary insured reverse courier pickup from your doorstep.
        </p>
      `
    },
    shipping: {
      title: "INSURED SHIPPING & DOORSTEP DELIVERY",
      content: `
        <p style="font-size: 0.8125rem; line-height: 1.6; color: #444; margin-bottom: 1rem;">
          Every acquisition from The Rare Avenue is handled with white-glove security from our global ateliers directly to your doorstep.
        </p>
        <h4 style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: #1a1a1a; margin: 1.25rem 0 0.5rem 0;">Delivery Timelines:</h4>
        <ul style="font-size: 0.8125rem; line-height: 1.6; color: #444; padding-left: 1.25rem; margin: 0 0 1rem 0;">
          <li><strong>Ready to Ship Items:</strong> Dispatched within 24 hours. Express air transit takes <strong>2 to 4 business days</strong> across metro cities.</li>
          <li><strong>International Atelier Curations:</strong> Sourced from authorized boutiques across North America, Europe, and Japan. Transit, custom clearance, and doorstep delivery take <strong>6 to 9 business days</strong>.</li>
        </ul>
        <h4 style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: #1a1a1a; margin: 1.25rem 0 0.5rem 0;">Duties, Taxes &amp; Packaging:</h4>
        <ul style="font-size: 0.8125rem; line-height: 1.6; color: #444; padding-left: 1.25rem; margin: 0 0 1rem 0;">
          <li><strong>All-Inclusive Pricing:</strong> All Indian customs import duties, tariffs, and GST are 100% prepaid by The Rare Avenue. You will never encounter unexpected fees at delivery.</li>
          <li><strong>Double-Box Protection:</strong> Luxury footwear and handbags are always double-boxed in high-rigidity corrugated outer cartons to safeguard collectible boxes and fine leather.</li>
          <li><strong>End-to-End Insurance:</strong> Every parcel is fully insured against loss, transit damage, or theft until signed for at your door.</li>
        </ul>
      `
    },
    authenticity: {
      title: "100% PROVENANCE & AUTHENTICITY GUARANTEE",
      content: `
        <p style="font-size: 0.8125rem; line-height: 1.6; color: #444; margin-bottom: 1rem;">
          At The Rare Avenue, authenticity is not a promise—it is our founding principle. We maintain an uncompromising zero-tolerance policy regarding counterfeit goods.
        </p>
        <h4 style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: #1a1a1a; margin: 1.25rem 0 0.5rem 0;">Our Multi-Tier Verification Process:</h4>
        <ul style="font-size: 0.8125rem; line-height: 1.6; color: #444; padding-left: 1.25rem; margin: 0 0 1rem 0;">
          <li><strong>Direct Boutique Sourcing:</strong> Our procurement network sources exclusively from authorized flagship boutiques, tier-1 luxury department stores (Nordstrom, Saks, Sephora), and verified brand distributors.</li>
          <li><strong>Independent CheckCheck® Protocol:</strong> For streetwear footwear and high-risk sneakers, items undergo physical multi-point verification via CheckCheck with serialized tamper-proof tags and verifiable digital Certificates of Authenticity.</li>
          <li><strong>Horology Quality Assurance:</strong> Swiss timepieces include complete serial hallmarks, official reference numbers, and presentation cases with international service validity.</li>
          <li><strong>Full Money-Back Guarantee:</strong> In the extraordinary event that an item is ever shown to fall short of 100% authenticity, we provide an immediate 100% refund including all shipping costs.</li>
        </ul>
      `
    },
    terms: {
      title: "TERMS OF SERVICE & CLIENT AGREEMENT",
      content: `
        <p style="font-size: 0.8125rem; line-height: 1.6; color: #444; margin-bottom: 1rem;">
          Welcome to <strong>The Rare Avenue</strong>. By acquiring merchandise through our digital atelier, you agree to the following terms designed to protect our clientele and preserve the integrity of our curated collections.
        </p>
        <h4 style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: #1a1a1a; margin: 1.25rem 0 0.5rem 0;">Orders &amp; Acquisitions:</h4>
        <p style="font-size: 0.8125rem; line-height: 1.6; color: #444; margin-bottom: 0.5rem;">
          All orders are subject to inventory verification and authenticity inspection prior to final courier dispatch. In the rare event an item fails pre-shipment authentication or is unavailable at our partner flagship, a full 100% refund is immediately processed.
        </p>
        <h4 style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: #1a1a1a; margin: 1.25rem 0 0.5rem 0;">Pricing &amp; Taxes:</h4>
        <p style="font-size: 0.8125rem; line-height: 1.6; color: #444; margin-bottom: 0.5rem;">
          All listed prices are displayed in Indian Rupees (INR) and are strictly inclusive of all import duties, customs tariffs, insurance, and GST. No supplemental charges will ever be levied upon delivery.
        </p>
      `
    },
    privacy: {
      title: "CLIENT PRIVACY & DATA PROTECTION",
      content: `
        <p style="font-size: 0.8125rem; line-height: 1.6; color: #444; margin-bottom: 1rem;">
          At <strong>The Rare Avenue</strong>, discretion and client confidentiality are held in the highest regard. We treat your personal details and acquisition records with rigorous data security standards.
        </p>
        <h4 style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: #1a1a1a; margin: 1.25rem 0 0.5rem 0;">Information Handling:</h4>
        <p style="font-size: 0.8125rem; line-height: 1.6; color: #444; margin-bottom: 0.5rem;">
          We collect personal identifying information (name, shipping address, contact phone, email) solely for the fulfillment, insurance coverage, and white-glove delivery of your orders. Your data is never sold, leased, or distributed to third-party marketing entities.
        </p>
        <h4 style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: #1a1a1a; margin: 1.25rem 0 0.5rem 0;">Encrypted Transactions:</h4>
        <p style="font-size: 0.8125rem; line-height: 1.6; color: #444; margin-bottom: 0.5rem;">
          Payment processing is managed exclusively through certified Level-1 PCI-DSS compliant gateways utilizing 256-bit SSL encryption. We never store raw payment card data on our servers.
        </p>
      `
    }
  };

  function openPolicyModal(policyKey) {
    var modal = document.getElementById('ra-policy-modal');
    var contentEl = document.getElementById('ra-policy-modal-content');
    var policy = RA_POLICIES[policyKey];
    if (!modal || !contentEl || !policy) return;

    contentEl.innerHTML = `
      <h3 style="font-family: var(--font-heading--family, serif); font-size: 1.05rem; font-weight: 600; letter-spacing: 0.06em; color: #1a1a1a; margin: 0 0 1.25rem 0; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(0,0,0,0.1);">${policy.title}</h3>
      <div>${policy.content}</div>
    `;

    modal.style.display = 'flex';
    modal.style.pointerEvents = 'all';
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closePolicyModal() {
    var modal = document.getElementById('ra-policy-modal');
    if (!modal) return;
    modal.style.display = 'none';
    modal.style.pointerEvents = 'none';
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closePolicyModal();
  });

  // Client-side Policy URL Resolver (Transforms 404 policy URLs into luxury policy views)
  (function initPolicyUrlResolver() {
    var path = window.location.pathname.toLowerCase();
    if (path.indexOf('/policies/') !== -1) {
      var key = 'returns';
      if (path.indexOf('shipping') !== -1) key = 'shipping';
      else if (path.indexOf('authenticity') !== -1) key = 'authenticity';
      else if (path.indexOf('terms') !== -1) key = 'terms';
      else if (path.indexOf('privacy') !== -1) key = 'privacy';

      var pol = RA_POLICIES[key];
      if (pol) {
        document.title = pol.title + " – The Rare Avenue";
        var renderPolicyPage = function() {
          var main = document.getElementById('MainContent');
          if (main) {
            main.innerHTML = '<div class="page-width" style="max-width: 840px; margin: 4rem auto; padding: 2.5rem 1.5rem; background: #fff; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);"><h1 style="font-family: var(--font-heading--family, serif); font-size: 1.6rem; font-weight: 600; letter-spacing: 0.05em; color: #1a1a1a; margin: 0 0 2rem 0; padding-bottom: 1rem; border-bottom: 1px solid rgba(0,0,0,0.1);">' + pol.title + '</h1><div style="font-size: 0.9rem; line-height: 1.7; color: #333;">' + pol.content + '</div></div>';
            window.scrollTo(0, 0);
          }
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', renderPolicyPage);
        } else {
          renderPolicyPage();
        }
      }
    }
  })();
</script>

<style>
  /* ==========================================================================
     THE RARE AVENUE QUIET LUXURY FOOTER CONCIERGE STYLES (ADR 0031)
     ========================================================================== */
  .luxury-footer-concierge {
    width: 100%;
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    color: #1a1a1a;
  }

  .luxury-footer-concierge__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    align-items: start;
  }

  @media screen and (min-width: 768px) {
    .luxury-footer-concierge__grid {
      grid-template-columns: 1.1fr 1.3fr 1.1fr;
      gap: 2.5rem;
    }
  }

  /* Column 1: Maison */
  .luxury-footer-concierge__brand-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
  }

  .luxury-footer-concierge__monogram {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #1a1a1a;
  }

  .luxury-footer-concierge__badge {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c9a876;
    background: #faf8f5;
    padding: 0.15rem 0.45rem;
    border-radius: 10px;
    border: 1px solid rgba(201, 168, 118, 0.35);
  }

  .luxury-footer-concierge__tagline {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #666666;
    margin: 0 0 1.25rem 0;
  }

  .luxury-footer-concierge__trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #2b2b2b;
    background: #faf8f5;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    border: 1px solid rgba(201, 168, 118, 0.25);
  }

  /* Headings */
  .luxury-footer-concierge__heading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1a1a1a;
    margin: 0 0 0.85rem 0;
  }

  .luxury-footer-concierge__desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #666666;
    margin: 0 0 1.15rem 0;
  }

  /* Action Cards */
  .luxury-footer-concierge__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .luxury-footer-concierge__card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    background: #faf8f5;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    text-decoration: none;
    color: #1a1a1a;
    transition: all 0.22s ease-in-out;
  }

  .luxury-footer-concierge__card:hover {
    background: #ffffff;
    border-color: #c9a876;
