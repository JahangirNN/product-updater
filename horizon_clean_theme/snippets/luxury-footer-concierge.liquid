  }

  .luxury-footer-concierge__card-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .luxury-footer-concierge__card-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8c827a;
    line-height: 1.2;
  }

  .luxury-footer-concierge__card-value {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #1a1a1a;
    margin-top: 0.15rem;
    word-break: break-word;
  }

  .luxury-footer-concierge__card-sub {
    font-size: 0.6875rem;
    color: #c9a876;
    margin-top: 0.2rem;
    font-weight: 500;
  }

  .luxury-footer-concierge__schedule {
    display: flex;
    align-items: center;
    gap: 0.45rem;
