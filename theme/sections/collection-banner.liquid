{%- if section.settings.show_image == false or collection.image == blank and section.settings.image == blank -%}
  {%- assign show_image = false -%}
{%- else -%}
  {%- assign show_image = true -%}
{%- endif -%}

{%- capture collection_breadcrumb -%}
  {%- if section.settings.show_breadcrumb -%}
    {%- render 'luxury-breadcrumbs', floating: show_image, show_image: show_image -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture collection_content -%}
  {%- if section.settings.show_collection_title -%}
    <h1 class="h1">{{ collection.title }}</h1>
  {%- endif -%}

  {%- if section.settings.show_collection_description -%}
    <div class="collection-description">
      {{- collection.description -}}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- if show_image -%}
  {%- assign banner_img = section.settings.image | default: collection.image -%}
  {%- assign focal_point = banner_img.presentation.focal_point | default: '50% 60%' -%}
  <style>
    #shopify-section-{{ section.id }} {
      --content-over-media-overlay: transparent;
      --content-over-media-content-max-width: var(--container-{{ section.settings.content_width }}-max-width);
      --collection-focal-point: {{ focal_point }};
    }

    #shopify-section-{{ section.id }} .collection-banner,
    .shopify-section--collection-banner .collection-banner {
      display: block;
      position: relative;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .content-over-media,
    .shopify-section--collection-banner .content-over-media {
      --content-over-media-height: clamp(300px, 32vh, 360px);
      min-height: clamp(300px, 32vh, 360px) !important;
      max-height: 380px !important;
      height: clamp(300px, 32vh, 360px) !important;
    }

    /* Support transparent header gracefully if explicitly toggled on */
    .shopify-section--collection-banner:has([allow-transparent-header]) .content-over-media,
    #shopify-section-{{ section.id }}:has([allow-transparent-header]) .content-over-media {
      --content-over-media-height: calc(340px + var(--header-height, 0px)) !important;
      min-height: calc(340px + var(--header-height, 0px)) !important;
      max-height: calc(380px + var(--header-height, 0px)) !important;
      height: calc(340px + var(--header-height, 0px)) !important;
    }

    #shopify-section-{{ section.id }} .content-over-media > picture img,
    #shopify-section-{{ section.id }} .content-over-media > image-parallax img,
    #shopify-section-{{ section.id }} .content-over-media > img,
    .shopify-section--collection-banner .content-over-media > picture img,
    .shopify-section--collection-banner .content-over-media > image-parallax img,
    .shopify-section--collection-banner .content-over-media > img {
      width: 100% !important;
      height: 100% !important;
      min-height: 100% !important;
      max-height: 100% !important;
      object-fit: cover !important;
      object-position: var(--collection-focal-point, 50% 60%) !important;
    }

    /* Architectural luxury vignette overlay */
    #shopify-section-{{ section.id }} .content-over-media::before,
    .shopify-section--collection-banner .content-over-media::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(12, 12, 12, 0.28) 0%, rgba(12, 12, 12, 0.58) 100%) !important;
      z-index: 1;
      pointer-events: none;
    }

    /* Refined editorial typography with guaranteed immediate visibility */
    #shopify-section-{{ section.id }} .collection-banner .prose,
    .shopify-section--collection-banner .collection-banner .prose {
      z-index: 2;
      position: relative;
      padding-inline: 1.5rem;
      max-width: 48rem;
      margin-inline: auto;
      text-align: center;
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }

    #shopify-section-{{ section.id }} .collection-banner h1,
    #shopify-section-{{ section.id }} .collection-banner .h1,
    .shopify-section--collection-banner .collection-banner h1,
    .shopify-section--collection-banner .collection-banner .h1 {
      font-size: clamp(1.75rem, 3.2vw, 2.35rem) !important;
      font-weight: 500 !important;
      letter-spacing: 0.2em !important;
      text-transform: uppercase !important;
      color: #ffffff !important;
      line-height: 1.2 !important;
      margin: 0 0 0.5rem 0 !important;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    }

    #shopify-section-{{ section.id }} .collection-banner .collection-description,
    .shopify-section--collection-banner .collection-banner .collection-description {
      font-size: clamp(0.8125rem, 1.1vw, 0.9rem) !important;
      font-weight: 400 !important;
      line-height: 1.6 !important;
      letter-spacing: 0.03em !important;
      color: rgba(255, 255, 255, 0.9) !important;
      max-width: 40rem;
      margin-inline: auto;
      margin-block-start: 0.25rem;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .collection-banner .breadcrumb--floating,
    .shopify-section--collection-banner .collection-banner .breadcrumb--floating {
      position: absolute;
      inset-block-start: 1.25rem;
      inset-inline-start: var(--container-gutter, 2rem);
      z-index: 3;
    }

    #shopify-section-{{ section.id }} .collection-banner .breadcrumb a,
    #shopify-section-{{ section.id }} .collection-banner .breadcrumb li,
    .shopify-section--collection-banner .collection-banner .breadcrumb a,
    .shopify-section--collection-banner .collection-banner .breadcrumb li {
      color: rgba(255, 255, 255, 0.75) !important;
      font-size: 0.72rem !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    }

    #shopify-section-{{ section.id }} .collection-banner .breadcrumb a:hover,
    .shopify-section--collection-banner .collection-banner .breadcrumb a:hover {
      color: #ffffff !important;
    }

    @media screen and (max-width: 999px) {
      #shopify-section-{{ section.id }} .content-over-media,
      .shopify-section--collection-banner .content-over-media {
        --content-over-media-height: 280px !important;
        min-height: 280px !important;
        max-height: 280px !important;
        height: 280px !important;
      }
    }

    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .content-over-media,
      .shopify-section--collection-banner .content-over-media {
        --content-over-media-height: 240px !important;
        min-height: 240px !important;
        max-height: 240px !important;
        height: 240px !important;
      }

      #shopify-section-{{ section.id }} .collection-banner h1,
      #shopify-section-{{ section.id }} .collection-banner .h1,
      .shopify-section--collection-banner .collection-banner h1,
      .shopify-section--collection-banner .collection-banner .h1 {
        font-size: 1.35rem !important;
        letter-spacing: 0.15em !important;
        margin-bottom: 0.25rem !important;
      }

      #shopify-section-{{ section.id }} .collection-banner .collection-description,
      .shopify-section--collection-banner .collection-banner .collection-description {
        font-size: 0.76rem !important;
        line-height: 1.4 !important;
        -webkit-line-clamp: 2;
      }

      #shopify-section-{{ section.id }} .collection-banner .breadcrumb--floating,
      .shopify-section--collection-banner .collection-banner .breadcrumb--floating {
        inset-block-start: 0.75rem;
        inset-inline-start: 1rem;
      }
    }
  </style>

  <collection-banner {% if section.settings.reveal %}reveal-on-scroll="true"{% endif %} class="collection-banner color-scheme color-scheme--{{ section.settings.color_scheme.id }}" {% if section.settings.allow_transparent_header %}allow-transparent-header{% endif %}>
    {%- unless section.settings.allow_transparent_header -%}
      {{- collection_breadcrumb -}}
    {%- endunless -%}

    <div class="content-over-media content-over-media--{{ section.settings.image_size }}" style="--collection-focal-point: {{ focal_point }};">
      {%- capture picture_content -%}
        <picture>
          {%- if section.settings.mobile_image != blank -%}
            <source
                media="(max-width: 699px)"
                srcset="{{ section.settings.mobile_image | image_url: width: 400 }} 400w, {{ section.settings.mobile_image | image_url: width: 600 }} 600w, {{ section.settings.mobile_image | image_url: width: 800 }} 800w, {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w"
                width="{{ section.settings.mobile_image.width }}"
                height="{{ section.settings.mobile_image.height }}"
            >
          {%- endif -%}

          {%- assign image = banner_img -%}
          {{- image | image_url: width: image.width | image_tag: fetchpriority: 'high', widths: '300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200' -}}
        </picture>
      {%- endcapture -%}

      {%- if section.settings.enable_parallax -%}
        <image-parallax class="contents">
          {{- picture_content -}}
        </image-parallax>
      {%- else -%}
        {{- picture_content -}}
      {%- endif -%}

      <div class="prose text-center">
        {{ collection_content }}
      </div>
    </div>
  </collection-banner>
{%- elsif collection_content != blank -%}
  <style>
    .shopify-section--collection-banner .container > .breadcrumb:not(.breadcrumb--floating) {
      margin-bottom: 0.85rem;
      display: flex;
      justify-content: center;
    }
    .shopify-section--collection-banner .container > .breadcrumb:not(.breadcrumb--floating) .breadcrumb__list {
      justify-content: center;
    }
    .shopify-section--collection-banner .color-scheme--scheme-1 h1,
    .shopify-section--collection-banner .color-scheme--scheme-1 .h1 {
      letter-spacing: 0.18em !important;
      text-transform: uppercase !important;
      font-weight: 500 !important;
      font-size: clamp(1.75rem, 3vw, 2.25rem) !important;
    }
  </style>
  <div class="color-scheme color-scheme--scheme-1" style="--text-color: 26 26 26; color: #1a1a1a;">
    <div class="relative section-spacing section-spacing--tight">
      <div class="container container--{{ section.settings.content_width }}">
        {{- collection_breadcrumb -}}

        <div class="prose text-center">
          {{- collection_content -}}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.collection_banner.name",
  "class": "shopify-section--collection-banner",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-4"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:global.image.image",
      "info": "t:sections.collection_banner.image_info"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:global.image.mobile_image",
      "info": "t:sections.collection_banner.mobile_image_info"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "t:global.image.size",
      "options": [
        {
          "value": "auto",
          "label": "t:global.sizes.original_image_ratio"
        },
        {
          "value": "xs",
          "label": "t:global.sizes.x_small"
        },
        {
          "value": "sm",
          "label": "t:global.sizes.small"
        },
        {
          "value": "md",
          "label": "t:global.sizes.medium"
        },
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        }
      ],
      "info": "t:global.image.ratio_avoid_cropping_info",
      "default": "xs"
    },
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "t:global.section.allow_transparent_header",
      "info": "t:global.section.allow_transparent_header_info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.collection_banner.show_image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "t:sections.collection_banner.reveal",
      "default": false,
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "t:sections.collection_banner.enable_parallax",
      "info": "t:sections.collection_banner.enable_parallax_info",
      "default": false,
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "t:sections.collection_banner.show_collection_title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "t:sections.collection_banner.show_collection_description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.collection_banner.show_breadcrumb",
      "default": true
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:global.sizes.content_width",
      "options": [
        {
          "value": "xs",
          "label": "t:global.sizes.x_small"
        },
        {
          "value": "sm",
          "label": "t:global.sizes.small"
        },
        {
          "value": "md",
          "label": "t:global.sizes.medium"
        },
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "xl",
          "label": "t:global.sizes.x_large"
        }
      ],
      "default": "xs"
    },
    {
      "type": "header",
      "content": "t:global.colors.category",
      "info": "t:sections.collection_banner.colors_category_info"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:global.colors.overlay_color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:global.colors.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 40
    }
  ]
}
{% endschema %}
