<script>
  (function() {
    function setupMobileNavigation() {
      // Level 1 Accordion Logic
      const lvl1Items = document.querySelectorAll('.luxury-sidebar-nav-container [data-accordion-item]');
      lvl1Items.forEach(function(item) {
        const header = item.querySelector('[data-accordion-trigger]');
        if (!header) return;

        // Clean event listener
        header.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          const isOpen = item.classList.contains('is-open');

          // Smoothly close siblings for a pristine luxury experience
          lvl1Items.forEach(function(sibling) {
            if (sibling !== item && sibling.classList.contains('is-open')) {
              sibling.classList.remove('is-open');
              const sibHeader = sibling.querySelector('[data-accordion-trigger]');
              if (sibHeader) sibHeader.setAttribute('aria-expanded', 'false');
            }
          });

          if (isOpen) {
            item.classList.remove('is-open');
            header.setAttribute('aria-expanded', 'false');
          } else {
            item.classList.add('is-open');
            header.setAttribute('aria-expanded', 'true');
          }
        };

        // Keyboard accessibility
        header.onkeydown = function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            header.click();
          }
        };
      });

      // Level 2 Sub-Accordion Logic
      const lvl2Items = document.querySelectorAll('.luxury-sidebar-nav-container [data-sub-accordion-item]');
      lvl2Items.forEach(function(subItem) {
        const subHeader = subItem.querySelector('[data-sub-accordion-trigger]');
        if (!subHeader) return;

        subHeader.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          const isOpen = subItem.classList.contains('is-open');

          // Optional: close other sub-accordions within the same level 1 parent
          const parentLvl1 = subItem.closest('.luxury-lvl1-item');
          if (parentLvl1) {
            parentLvl1.querySelectorAll('[data-sub-accordion-item]').forEach(function(sibSub) {
              if (sibSub !== subItem && sibSub.classList.contains('is-open')) {
                sibSub.classList.remove('is-open');
                const sibH = sibSub.querySelector('[data-sub-accordion-trigger]');
                if (sibH) sibH.setAttribute('aria-expanded', 'false');
              }
            });
          }

          if (isOpen) {
            subItem.classList.remove('is-open');
            subHeader.setAttribute('aria-expanded', 'false');
          } else {
            subItem.classList.add('is-open');
            subHeader.setAttribute('aria-expanded', 'true');
          }
        };

        subHeader.onkeydown = function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            subHeader.click();
          }
        };
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupMobileNavigation);
    } else {
      setupMobileNavigation();
    }
    // Re-bind when Shopify drawer opens or mutates
    document.addEventListener('shopify:section:load', setupMobileNavigation);
  })();
</script>
