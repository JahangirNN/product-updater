{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
FACETING
----------------------------------------------------------------------------------------------------------------------

Display the facets for a given resource.

********************************************
Supported variables
********************************************

* results: either collection or search drop to extract the filters from
* show_filters: a boolean indicating if the filters should show or not (this is useful if merchants want only to show
                the quick links without filters, for instance)
* open_filters_by_default: if set to true, all the collapsible filters are automatically open
* update_on_change: if set to true the results will reload as soon as an option is changed
* quick_links_menu: an optional menu that will show fixed links
* context: an optional context to generate unique ID if facets are outputted several times
{%- endcomment -%}

{%- assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ',' -%}
{%- capture id_prefix -%}facets-{{ context }}{%- endcapture -%}

<facets-form {% if update_on_change %}update-on-change{% endif %} section-id="{{ section.id }}">
  <form method="GET" action="{{ request.path }}" class="facets">
    {%- comment -%}We always reset to the first page so that when criteria change, the page is restored to the first one{%- endcomment -%}
    <input type="hidden" name="page" value="">

    {%- if results.current_type != blank or results.current_vendor != blank -%}
      <input type="hidden" name="q" value="{{ results.current_vendor | default: results.current_type | escape }}">
    {%- endif -%}

    {%- if results.sort_by != blank -%}
      <input type="hidden" name="sort_by" value="{{ results.sort_by }}">
    {%- endif -%}

    {%- if request.page_type == 'search' -%}
      <input type="hidden" name="q" value="{{ results.terms | escape }}">
    {%- endif -%}

    <div class="accordion-list">
      {%- if quick_links_menu.links.size > 0 -%}
        {%- capture filter_content -%}
          <div class="v-stack gap-2.5">
            {%- for link in quick_links_menu.links -%}
              <a href="{{ link.url }}" {% unless link.active %}class="link-faded"{% endunless %}>{{ link.title }}</a>
            {%- endfor -%}
          </div>
        {%- endcapture -%}

        {%- render 'accordion', title: quick_links_menu.title, content: filter_content, open: open_filters_by_default, show_arrow: true -%}
      {%- endif -%}

      {%- if show_filters -%}
        {%- liquid
          assign has_native_vendor_filter = false
          for f in results.filters
            if f.param_name == 'filter.p.vendor'
              assign has_native_vendor_filter = true
            endif
          endfor

          assign show_gender_filter = false
          if request.page_type == 'collection'
            if collection.handle contains 'all' or collection.handle contains 'luxury-watches'
              assign show_gender_filter = true
            elsif collection.handle != 'womens-watches' and collection.handle != 'mens-watches' and collection.handle != 'womens-handbags' and collection.handle != 'womens-shoes' and collection.handle != 'mens-shoes' and collection.handle != 'mens-bags' and collection.handle != 'women' and collection.handle != 'men'
              assign show_gender_filter = true
            endif
          endif
        -%}

        {%- if show_gender_filter -%}
          {%- liquid
            assign is_men_active = false
            assign is_women_active = false
            for tag in current_tags
              assign tag_lower = tag | downcase
              if tag_lower == 'men' or tag_lower == 'mens' or tag_lower == "men's"
                assign is_men_active = true
              elsif tag_lower == 'women' or tag_lower == 'womens' or tag_lower == "women's"
                assign is_women_active = true
              endif
            endfor

            assign is_all_gender_active = false
            if is_men_active == false and is_women_active == false
              assign is_all_gender_active = true
            endif
          -%}

          {%- capture gender_filter_content -%}
            <div class="v-stack gap-2.5">
              {%- capture all_gender_url -%}{{ collection.url }}{% if results.sort_by != blank %}?sort_by={{ results.sort_by }}{% endif %}{%- endcapture -%}
              <div class="checkbox-control">
                <facet-link class="block w-full">
                  <a href="{{ all_gender_url }}" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                    <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                      <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background-color: currentColor; opacity: {% if is_all_gender_active %}1{% else %}0{% endif %}; transition: opacity 0.2s;"></span>
                      <span class="{% if is_all_gender_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">All Pieces</span>
                    </span>
                  </a>
                </facet-link>
              </div>

              {%- capture men_gender_url -%}
                {%- if is_men_active -%}{{ collection.url }}{%- else -%}{{ collection.url }}/men{%- endif -%}
                {%- if results.sort_by != blank %}?sort_by={{ results.sort_by }}{% endif -%}
              {%- endcapture -%}
              <div class="checkbox-control">
                <facet-link class="block w-full">
                  <a href="{{ men_gender_url }}" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                    <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                      <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background-color: currentColor; opacity: {% if is_men_active %}1{% else %}0{% endif %}; transition: opacity 0.2s;"></span>
                      <span class="{% if is_men_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">Men's</span>
                    </span>
                  </a>
                </facet-link>
              </div>

              {%- capture women_gender_url -%}
                {%- if is_women_active -%}{{ collection.url }}{%- else -%}{{ collection.url }}/women{%- endif -%}
                {%- if results.sort_by != blank %}?sort_by={{ results.sort_by }}{% endif -%}
              {%- endcapture -%}
              <div class="checkbox-control">
                <facet-link class="block w-full">
                  <a href="{{ women_gender_url }}" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                    <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                      <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background-color: currentColor; opacity: {% if is_women_active %}1{% else %}0{% endif %}; transition: opacity 0.2s;"></span>
                      <span class="{% if is_women_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">Women's</span>
                    </span>
                  </a>
                </facet-link>
              </div>
            </div>
          {%- endcapture -%}

          {%- render 'accordion', title: 'Gender', content: gender_filter_content, open: open_filters_by_default, show_arrow: true -%}
        {%- endif -%}

        {%- liquid
          assign show_brand_filter = false
          if request.page_type == 'collection' and collection.all_vendors.size > 1 and has_native_vendor_filter == false
            assign show_brand_filter = true
          endif
        -%}

        {%- if show_brand_filter -%}
          {%- capture brand_filter_content -%}
            <div class="v-stack gap-2.5">
              {%- for vendor in collection.all_vendors -%}
                {%- liquid
                  assign vendor_handle = vendor | handleize
                  assign is_vendor_active = false
                  for tag in current_tags
                    assign tag_handle = tag | handleize
                    if tag_handle == vendor_handle
                      assign is_vendor_active = true
                      break
                    endif
                  endfor

                  assign filter_tag_param = vendor_handle
                  if vendor_handle == 'on-running'
                    assign filter_tag_param = 'on'
                  endif
                -%}

                {%- capture vendor_target_url -%}
                  {%- if is_vendor_active -%}
                    {{ collection.url }}
                  {%- else -%}
                    {{ collection.url }}/{{ filter_tag_param }}
                  {%- endif -%}
                  {%- if results.sort_by != blank %}?sort_by={{ results.sort_by }}{% endif -%}
                {%- endcapture -%}

                <div class="checkbox-control">
                  <facet-link class="block w-full">
                    <a href="{{ vendor_target_url }}" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                      <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                        <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background-color: currentColor; opacity: {% if is_vendor_active %}1{% else %}0{% endif %}; transition: opacity 0.2s;"></span>
                        <span class="{% if is_vendor_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">{{ vendor }}</span>
                      </span>
                    </a>
                  </facet-link>
                </div>
              {%- endfor -%}
            </div>
          {%- endcapture -%}

          {%- render 'accordion', title: 'Brand', content: brand_filter_content, open: open_filters_by_default, show_arrow: true -%}
        {%- endif -%}

        {%- for filter in results.filters -%}
          {%- capture filter_content -%}
            {%- if filter.type == 'boolean' or filter.param_name == 'filter.v.availability' -%}
              {%- if filter.param_name == 'filter.v.availability' -%}
                <div class="checkbox-control">
                  <input id="{{ id_prefix }}-{{ filter.param_name }}" type="checkbox" class="switch" name="{{ filter.param_name }}" value="1" {% if filter.active_values.size > 0 %}checked{% endif %}>
                  <label for="{{ id_prefix }}-{{ filter.param_name }}" class="text-subdued">{{- 'collection.faceting.in_stock_only' | t -}}</label>
                </div>
              {%- else -%}
                <div class="v-stack gap-2.5">
                  {%- for filter_value in filter.values -%}
                    {%- liquid
                      if section.settings.show_filter_values_count
                        assign label = filter_value.label | append: ' (' | append: filter_value.count | append: ')'
                      else
                        assign label = filter_value.label
                      endif
                    -%}

                    <div class="checkbox-control">
                      {%- capture boolean_index -%}{% increment filter_boolean %}{%- endcapture -%}

                      <input id="{{ id_prefix }}-{{ filter_value.param_name }}-{{ boolean_index }}" type="checkbox" class="switch" name="{{ filter_value.param_name }}" value="{{ filter_value.value }}" {% if filter_value.active %}checked{% endif %}>
                      <label for="{{ id_prefix }}-{{ filter_value.param_name }}-{{ boolean_index }}" class="text-subdued">{{ label }}</label>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            {%- else -%}
              {%- assign downcase_label = filter.label | downcase -%}

              {%- case filter.type -%}
                {%- when 'list' -%}
                  {%- liquid
                    if filter.presentation == 'image'
                      assign wrapper_class_list = 'v-stack gap-2'
                    elsif filter.presentation == 'swatch' or color_label_list contains downcase_label
                      assign wrapper_class_list = 'h-stack wrap gap-2'
                    else
                      assign wrapper_class_list = 'v-stack gap-2.5'
                    endif
                  -%}

                  <div class="{{ wrapper_class_list }}">
                    {% liquid
                      for filter_value in filter.values
                        assign value_id_prefix = id_prefix | append: '-' | append: forloop.index

                        if filter.presentation == 'image'
                          render 'option-value', type: 'image_filter', filter_value: filter_value, id_prefix: value_id_prefix
                        elsif filter.presentation == 'swatch' or color_label_list contains downcase_label
                          render 'option-value', type: 'swatch', filter_value: filter_value, show_tooltip: true, id_prefix: value_id_prefix
                        else
                          if section.settings.show_filter_values_count
                            assign label = filter_value.label | append: ' (' | append: filter_value.count | append: ')'
                          else
                            assign label = filter_value.label
                          endif

                          render 'checkbox', hide_checkbox: true, label: label, name: filter_value.param_name, value: filter_value.value, checked: filter_value.active, id_prefix: value_id_prefix
                        endif
                      endfor
                    %}
                  </div>

                {%- when 'price_range' -%}
                  {%- render 'price-range', filter: filter -%}
              {%- endcase -%}
            {%- endif -%}
          {%- endcapture -%}

          {%- if filter_content != blank -%}
            {%- render 'accordion', title: filter.label, content: filter_content, open: open_filters_by_default, show_arrow: true -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <noscript style="display: block; margin-top: 20px;">
      {%- assign button_content = 'collection.faceting.apply_filters' | t -%}
      {%- render 'button', content: button_content, stretch: true -%}
    </noscript>
  </form>
</facets-form>