{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
FACETING
----------------------------------------------------------------------------------------------------------------------

Display the facets for a given resource.

********************************************
Supported variables
********************************************

* results: either collection or search drop to extract the filters from
* show_filters: a boolean indicating if the filters should show or not (this is useful if merchants want only to show
                the quick links without filters, for instance)
* open_filters_by_default: if set to true, all the collapsible filters are automatically open
* update_on_change: if set to true the results will reload as soon as an option is changed
* quick_links_menu: an optional menu that will show fixed links
* context: an optional context to generate unique ID if facets are outputted several times
{%- endcomment -%}

{%- assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ',' -%}
{%- capture id_prefix -%}facets-{{ context }}{%- endcapture -%}

<facets-form {% if update_on_change %}update-on-change{% endif %} section-id="{{ section.id }}">
  <style>
    .luxury-facet-checkbox {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: 1.5px solid rgba(0, 0, 0, 0.3);
      background-color: transparent;
      flex-shrink: 0;
      box-sizing: border-box;
      transition: border-color 0.2s ease, background-color 0.2s ease;
    }
    .luxury-facet-checkbox--active {
      border-color: currentColor;
      background-color: currentColor;
    }
    .luxury-facet-checkbox--active::after {
      content: "";
      display: block;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background-color: #ffffff;
    }
    a:hover .luxury-facet-checkbox:not(.luxury-facet-checkbox--active) {
      border-color: rgba(0, 0, 0, 0.65);
    }
    .facets .dot-checkbox {
      opacity: 1 !important;
      background: transparent !important;
      border: 1.5px solid rgba(0, 0, 0, 0.3) !important;
      border-radius: 50% !important;
      width: 14px !important;
      height: 14px !important;
      inset-block-start: calc(0.5em - 1px) !important;
      transition: all 0.2s ease !important;
    }
    .facets .dot-checkbox:checked {
      background: currentColor !important;
      border-color: currentColor !important;
    }
  </style>
  <form method="GET" action="{{ request.path }}" class="facets">
    {%- comment -%}We always reset to the first page so that when criteria change, the page is restored to the first one{%- endcomment -%}
    <input type="hidden" name="page" value="">

    {%- if results.current_type != blank or results.current_vendor != blank -%}
      <input type="hidden" name="q" value="{{ results.current_vendor | default: results.current_type | escape }}">
    {%- endif -%}

    {%- if results.sort_by != blank -%}
      <input type="hidden" name="sort_by" value="{{ results.sort_by }}">
    {%- endif -%}

    {%- if request.page_type == 'search' -%}
      <input type="hidden" name="q" value="{{ results.terms | escape }}">
    {%- endif -%}

    <div class="accordion-list">
      {%- if quick_links_menu.links.size > 0 -%}
        {%- capture filter_content -%}
          <div class="v-stack gap-2.5">
            {%- for link in quick_links_menu.links -%}
              <a href="{{ link.url }}" {% unless link.active %}class="link-faded"{% endunless %}>{{ link.title }}</a>
            {%- endfor -%}
          </div>
        {%- endcapture -%}

        {%- render 'accordion', title: quick_links_menu.title, content: filter_content, open: open_filters_by_default, show_arrow: true -%}
      {%- endif -%}

      {%- if show_filters -%}
        {%- liquid
          assign has_native_vendor_filter = false
          for f in results.filters
            if f.param_name == 'filter.p.vendor'
              assign has_native_vendor_filter = true
            endif
          endfor

          assign show_gender_filter = false
          if request.page_type == 'collection'
            if collection.handle contains 'all' or collection.handle contains 'luxury-watches' or collection.handle == 'designer-eyewear'
              assign show_gender_filter = true
            elsif collection.handle != 'womens-watches' and collection.handle != 'mens-watches' and collection.handle != 'womens-handbags' and collection.handle != 'womens-bags' and collection.handle != 'womens-shoes' and collection.handle != 'mens-shoes' and collection.handle != 'mens-bags' and collection.handle != 'womens-sunglasses' and collection.handle != 'mens-sunglasses' and collection.handle != 'women' and collection.handle != 'men'
              assign show_gender_filter = true
            endif
          endif
        -%}

        {%- liquid
          assign is_men_active = false
          assign is_women_active = false
          for tag in current_tags
            assign tag_lower = tag | downcase
            if tag_lower == 'men' or tag_lower == 'mens' or tag_lower == "men's"
              assign is_men_active = true
            elsif tag_lower == 'women' or tag_lower == 'womens' or tag_lower == "women's"
              assign is_women_active = true
            endif
          endfor

          assign is_all_gender_active = false
          if is_men_active == false and is_women_active == false
            assign is_all_gender_active = true
          endif

          assign is_bag_collection = false
          if collection.handle == 'womens-handbags' or collection.handle == 'mens-bags' or collection.handle == 'designer-bags' or collection.handle == 'luxury-bags'
            assign is_bag_collection = true
          endif

          assign active_vendor_tag = ''
          assign active_silhouette_tag = ''
          for tag in current_tags
            assign t_handle = tag | handleize
            if t_handle == 'on-running'
              assign t_handle = 'on'
            elsif t_handle == 'michael-michael-kors'
              assign t_handle = 'michael-kors'
            endif

            if t_handle == 'satchels' or t_handle == 'crossbody-bags' or t_handle == 'totes' or t_handle == 'shoulder-bags' or t_handle == 'backpacks' or t_handle == 'wallets'
              assign active_silhouette_tag = t_handle
            elsif t_handle != 'men' and t_handle != 'mens' and t_handle != 'women' and t_handle != 'womens'
              assign active_vendor_tag = t_handle
            endif
          endfor
        -%}

        {%- if show_gender_filter -%}
          {%- capture gender_filter_content -%}
            <div class="v-stack gap-2.5">
              {%- capture all_gender_url -%}
                {%- if collection.handle == 'designer-bags' or collection.handle == 'luxury-bags' -%}
                  /collections/designer-bags
                {%- elsif active_vendor_tag != '' -%}{{ collection.url }}/{{ active_vendor_tag }}{%- else -%}{{ collection.url }}{%- endif -%}
                {%- if results.sort_by != blank and collection.handle != 'designer-bags' and collection.handle != 'luxury-bags' %}?sort_by={{ results.sort_by }}{% endif -%}
              {%- endcapture -%}
              <div class="checkbox-control">
                <facet-link class="block w-full">
                  <a href="{{ all_gender_url | strip }}" data-tag-link="true" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                    <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                      <span class="luxury-facet-checkbox{% if is_all_gender_active %} luxury-facet-checkbox--active{% endif %}"></span>
                      <span class="{% if is_all_gender_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">All Pieces</span>
                    </span>
                  </a>
                </facet-link>
              </div>

              {%- capture men_gender_url -%}
                {%- if collection.handle == 'designer-eyewear' -%}
                  /collections/mens-sunglasses
                {%- elsif collection.handle == 'designer-bags' or collection.handle == 'luxury-bags' -%}
                  /collections/mens-bags
                {%- elsif is_men_active -%}
                  {%- if active_vendor_tag != '' -%}{{ collection.url }}/{{ active_vendor_tag }}{%- else -%}{{ collection.url }}{%- endif -%}
                {%- else -%}
                  {%- if active_vendor_tag != '' -%}{{ collection.url }}/men+{{ active_vendor_tag }}{%- else -%}{{ collection.url }}/men{%- endif -%}
                {%- endif -%}
                {%- if results.sort_by != blank and collection.handle != 'designer-eyewear' and collection.handle != 'designer-bags' and collection.handle != 'luxury-bags' %}?sort_by={{ results.sort_by }}{% endif -%}
              {%- endcapture -%}
              <div class="checkbox-control">
                <facet-link class="block w-full">
                  <a href="{{ men_gender_url | strip }}" data-tag-link="true" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                    <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                      <span class="luxury-facet-checkbox{% if is_men_active %} luxury-facet-checkbox--active{% endif %}"></span>
                      <span class="{% if is_men_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">Men's{% if collection.handle == 'designer-eyewear' %} (25){% endif %}</span>
                    </span>
                  </a>
                </facet-link>
              </div>

              {%- capture women_gender_url -%}
                {%- if collection.handle == 'designer-eyewear' -%}
                  /collections/womens-sunglasses
                {%- elsif collection.handle == 'designer-bags' or collection.handle == 'luxury-bags' -%}
                  /collections/womens-handbags
                {%- elsif is_women_active -%}
                  {%- if active_vendor_tag != '' -%}{{ collection.url }}/{{ active_vendor_tag }}{%- else -%}{{ collection.url }}{%- endif -%}
                {%- else -%}
                  {%- if active_vendor_tag != '' -%}{{ collection.url }}/women+{{ active_vendor_tag }}{%- else -%}{{ collection.url }}/women{%- endif -%}
                {%- endif -%}
                {%- if results.sort_by != blank and collection.handle != 'designer-eyewear' and collection.handle != 'designer-bags' and collection.handle != 'luxury-bags' %}?sort_by={{ results.sort_by }}{% endif -%}
              {%- endcapture -%}
              <div class="checkbox-control">
                <facet-link class="block w-full">
                  <a href="{{ women_gender_url | strip }}" data-tag-link="true" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                    <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                      <span class="luxury-facet-checkbox{% if is_women_active %} luxury-facet-checkbox--active{% endif %}"></span>
                      <span class="{% if is_women_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">Women's{% if collection.handle == 'designer-eyewear' %} (40){% endif %}</span>
                    </span>
                  </a>
                </facet-link>
              </div>
            </div>
          {%- endcapture -%}

          {%- assign gender_open = open_filters_by_default -%}
          {%- if is_men_active or is_women_active -%}
            {%- assign gender_open = true -%}
          {%- endif -%}
          {%- render 'accordion', title: 'Gender', content: gender_filter_content, open: gender_open, show_arrow: true -%}
        {%- endif -%}

        {%- if is_bag_collection -%}
          {%- capture silhouette_filter_content -%}
            <div class="v-stack gap-2.5">
              {%- comment -%} Satchels & Top Handles {%- endcomment -%}
              {%- liquid
                assign sil_active = false
                if active_silhouette_tag == 'satchels'
                  assign sil_active = true
                endif
              -%}
              {%- capture sil_url_satchels -%}
                {%- if sil_active -%}
                  {%- if active_vendor_tag != '' -%}{{ collection.url }}/{{ active_vendor_tag }}{%- else -%}{{ collection.url }}{%- endif -%}
                {%- else -%}
                  {%- if active_vendor_tag != '' -%}
                    {%- assign sorted_sil_tags = active_vendor_tag | append: ',' | append: 'satchels' | split: ',' | sort | join: '+' -%}
                    {{ collection.url }}/{{ sorted_sil_tags }}
                  {%- else -%}
                    {{ collection.url }}/satchels
                  {%- endif -%}
                {%- endif -%}
                {%- if results.sort_by != blank %}?sort_by={{ results.sort_by }}{% endif -%}
              {%- endcapture -%}
              <div class="checkbox-control">
                <facet-link class="block w-full">
                  <a href="{{ sil_url_satchels | strip }}" data-tag-link="true" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                    <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                      <span class="luxury-facet-checkbox{% if sil_active %} luxury-facet-checkbox--active{% endif %}"></span>
                      <span class="{% if sil_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">Satchels &amp; Top Handles</span>
                    </span>
                  </a>
                </facet-link>
              </div>

              {%- comment -%} Crossbody & Messengers {%- endcomment -%}
              {%- liquid
                assign sil_active = false
                if active_silhouette_tag == 'crossbody-bags'
                  assign sil_active = true
                endif
              -%}
              {%- capture sil_url_crossbody -%}
                {%- if sil_active -%}
                  {%- if active_vendor_tag != '' -%}{{ collection.url }}/{{ active_vendor_tag }}{%- else -%}{{ collection.url }}{%- endif -%}
                {%- else -%}
                  {%- if active_vendor_tag != '' -%}
                    {%- assign sorted_sil_tags = active_vendor_tag | append: ',' | append: 'crossbody-bags' | split: ',' | sort | join: '+' -%}
                    {{ collection.url }}/{{ sorted_sil_tags }}
                  {%- else -%}
                    {{ collection.url }}/crossbody-bags
                  {%- endif -%}
                {%- endif -%}
                {%- if results.sort_by != blank %}?sort_by={{ results.sort_by }}{% endif -%}
              {%- endcapture -%}
              <div class="checkbox-control">
                <facet-link class="block w-full">
                  <a href="{{ sil_url_crossbody | strip }}" data-tag-link="true" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                    <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                      <span class="luxury-facet-checkbox{% if sil_active %} luxury-facet-checkbox--active{% endif %}"></span>
                      <span class="{% if sil_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">Crossbody &amp; Messengers</span>
                    </span>
                  </a>
                </facet-link>
              </div>

              {%- comment -%} Totes & Carryalls {%- endcomment -%}
              {%- liquid
                assign sil_active = false
                if active_silhouette_tag == 'totes'
                  assign sil_active = true
                endif
              -%}
              {%- capture sil_url_totes -%}
                {%- if sil_active -%}
                  {%- if active_vendor_tag != '' -%}{{ collection.url }}/{{ active_vendor_tag }}{%- else -%}{{ collection.url }}{%- endif -%}
                {%- else -%}
                  {%- if active_vendor_tag != '' -%}
                    {%- assign sorted_sil_tags = active_vendor_tag | append: ',' | append: 'totes' | split: ',' | sort | join: '+' -%}
                    {{ collection.url }}/{{ sorted_sil_tags }}
                  {%- else -%}
                    {{ collection.url }}/totes
                  {%- endif -%}
                {%- endif -%}
                {%- if results.sort_by != blank %}?sort_by={{ results.sort_by }}{% endif -%}
              {%- endcapture -%}
              <div class="checkbox-control">
                <facet-link class="block w-full">
                  <a href="{{ sil_url_totes | strip }}" data-tag-link="true" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                    <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                      <span class="luxury-facet-checkbox{% if sil_active %} luxury-facet-checkbox--active{% endif %}"></span>
                      <span class="{% if sil_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">Totes &amp; Carryalls</span>
                    </span>
                  </a>
                </facet-link>
              </div>

              {%- comment -%} Shoulder Bags {%- endcomment -%}
              {%- liquid
                assign sil_active = false
                if active_silhouette_tag == 'shoulder-bags'
                  assign sil_active = true
                endif
              -%}
              {%- capture sil_url_shoulder -%}
                {%- if sil_active -%}
                  {%- if active_vendor_tag != '' -%}{{ collection.url }}/{{ active_vendor_tag }}{%- else -%}{{ collection.url }}{%- endif -%}
                {%- else -%}
                  {%- if active_vendor_tag != '' -%}
                    {%- assign sorted_sil_tags = active_vendor_tag | append: ',' | append: 'shoulder-bags' | split: ',' | sort | join: '+' -%}
                    {{ collection.url }}/{{ sorted_sil_tags }}
                  {%- else -%}
                    {{ collection.url }}/shoulder-bags
                  {%- endif -%}
                {%- endif -%}
                {%- if results.sort_by != blank %}?sort_by={{ results.sort_by }}{% endif -%}
              {%- endcapture -%}
              <div class="checkbox-control">
                <facet-link class="block w-full">
                  <a href="{{ sil_url_shoulder | strip }}" data-tag-link="true" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                    <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                      <span class="luxury-facet-checkbox{% if sil_active %} luxury-facet-checkbox--active{% endif %}"></span>
                      <span class="{% if sil_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">Shoulder Bags</span>
                    </span>
                  </a>
                </facet-link>
              </div>

              {%- comment -%} Backpacks & Rucksacks {%- endcomment -%}
              {%- liquid
                assign sil_active = false
                if active_silhouette_tag == 'backpacks'
                  assign sil_active = true
                endif
              -%}
              {%- capture sil_url_backpacks -%}
                {%- if sil_active -%}
                  {%- if active_vendor_tag != '' -%}{{ collection.url }}/{{ active_vendor_tag }}{%- else -%}{{ collection.url }}{%- endif -%}
                {%- else -%}
                  {%- if active_vendor_tag != '' -%}
                    {%- assign sorted_sil_tags = active_vendor_tag | append: ',' | append: 'backpacks' | split: ',' | sort | join: '+' -%}
                    {{ collection.url }}/{{ sorted_sil_tags }}
                  {%- else -%}
                    {{ collection.url }}/backpacks
                  {%- endif -%}
                {%- endif -%}
                {%- if results.sort_by != blank %}?sort_by={{ results.sort_by }}{% endif -%}
              {%- endcapture -%}
              <div class="checkbox-control">
                <facet-link class="block w-full">
                  <a href="{{ sil_url_backpacks | strip }}" data-tag-link="true" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                    <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                      <span class="luxury-facet-checkbox{% if sil_active %} luxury-facet-checkbox--active{% endif %}"></span>
                      <span class="{% if sil_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">Backpacks &amp; Rucksacks</span>
                    </span>
                  </a>
                </facet-link>
              </div>

              {%- comment -%} Wallets & Small Goods {%- endcomment -%}
              {%- liquid
                assign sil_active = false
                if active_silhouette_tag == 'wallets'
                  assign sil_active = true
                endif
              -%}
              {%- capture sil_url_wallets -%}
                {%- if sil_active -%}
                  {%- if active_vendor_tag != '' -%}{{ collection.url }}/{{ active_vendor_tag }}{%- else -%}{{ collection.url }}{%- endif -%}
                {%- else -%}
                  {%- if active_vendor_tag != '' -%}
                    {%- assign sorted_sil_tags = active_vendor_tag | append: ',' | append: 'wallets' | split: ',' | sort | join: '+' -%}
                    {{ collection.url }}/{{ sorted_sil_tags }}
                  {%- else -%}
                    {{ collection.url }}/wallets
                  {%- endif -%}
                {%- endif -%}
                {%- if results.sort_by != blank %}?sort_by={{ results.sort_by }}{% endif -%}
              {%- endcapture -%}
              <div class="checkbox-control">
                <facet-link class="block w-full">
                  <a href="{{ sil_url_wallets | strip }}" data-tag-link="true" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                    <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                      <span class="luxury-facet-checkbox{% if sil_active %} luxury-facet-checkbox--active{% endif %}"></span>
                      <span class="{% if sil_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">Wallets &amp; Small Goods</span>
                    </span>
                  </a>
                </facet-link>
              </div>
            </div>
          {%- endcapture -%}

          {%- assign silhouette_open = open_filters_by_default -%}
          {%- if active_silhouette_tag != '' -%}
            {%- assign silhouette_open = true -%}
          {%- endif -%}
          {%- render 'accordion', title: 'Silhouette', content: silhouette_filter_content, open: silhouette_open, show_arrow: true -%}
        {%- endif -%}

        {%- liquid
          assign show_brand_filter = false
          if request.page_type == 'collection' and collection.all_vendors.size > 1 and has_native_vendor_filter == false
            assign show_brand_filter = true
          endif
        -%}

        {%- if show_brand_filter -%}
          {%- capture brand_filter_content -%}
            <div class="v-stack gap-2.5">
              {%- assign current_gender_tag = '' -%}
              {%- if is_men_active -%}
                {%- assign current_gender_tag = 'men' -%}
              {%- elsif is_women_active -%}
                {%- assign current_gender_tag = 'women' -%}
              {%- endif -%}

              {%- assign rendered_vendors = '' -%}
              {%- for vendor in collection.all_vendors -%}
                {%- liquid
                  assign vendor_lower = vendor | downcase
                  assign display_vendor = vendor
                  if vendor_lower == 'michael michael kors' or vendor_lower == 'michael kors'
                    assign display_vendor = 'Michael Kors'
                  endif

                  assign vendor_check_token = '|' | append: display_vendor | append: '|'
                  if rendered_vendors contains vendor_check_token
                    continue
                  endif
                  assign rendered_vendors = rendered_vendors | append: '|' | append: display_vendor | append: '|'

                  assign vendor_handle = vendor | handleize
                  assign is_vendor_active = false
                  for tag in current_tags
                    assign tag_handle = tag | handleize
                    if tag_handle == vendor_handle or tag_handle == 'on' and vendor_handle == 'on-running' or tag_handle == 'michael-kors' and vendor_handle == 'michael-michael-kors' or tag_handle == 'michael-kors' and vendor_handle == 'michael-kors'
                      assign is_vendor_active = true
                      break
                    endif
                  endfor

                  assign filter_tag_param = vendor_handle
                  if vendor_handle == 'on-running'
                    assign filter_tag_param = 'on'
                  elsif vendor_handle == 'michael-michael-kors'
                    assign filter_tag_param = 'michael-kors'
                  endif
                -%}

                {%- capture vendor_target_url -%}
                  {%- if is_vendor_active -%}
                    {%- if active_silhouette_tag != '' -%}
                      {%- if current_gender_tag != '' -%}
                        {%- assign sorted_tags = current_gender_tag | append: ',' | append: active_silhouette_tag | split: ',' | sort | join: '+' -%}
                        {{ collection.url }}/{{ sorted_tags }}
                      {%- else -%}
                        {{ collection.url }}/{{ active_silhouette_tag }}
                      {%- endif -%}
                    {%- elsif current_gender_tag != '' -%}
                      {{ collection.url }}/{{ current_gender_tag }}
                    {%- else -%}
                      {{ collection.url }}
                    {%- endif -%}
                  {%- else -%}
                    {%- if active_silhouette_tag != '' -%}
                      {%- if current_gender_tag != '' -%}
                        {%- assign sorted_tags = current_gender_tag | append: ',' | append: filter_tag_param | append: ',' | append: active_silhouette_tag | split: ',' | sort | join: '+' -%}
                        {{ collection.url }}/{{ sorted_tags }}
                      {%- else -%}
                        {%- assign sorted_tags = filter_tag_param | append: ',' | append: active_silhouette_tag | split: ',' | sort | join: '+' -%}
                        {{ collection.url }}/{{ sorted_tags }}
                      {%- endif -%}
                    {%- elsif current_gender_tag != '' -%}
                      {%- assign sorted_tags = current_gender_tag | append: ',' | append: filter_tag_param | split: ',' | sort | join: '+' -%}
                      {{ collection.url }}/{{ sorted_tags }}
                    {%- else -%}
                      {{ collection.url }}/{{ filter_tag_param }}
                    {%- endif -%}
                  {%- endif -%}
                  {%- if results.sort_by != blank %}?sort_by={{ results.sort_by }}{% endif -%}
                {%- endcapture -%}

                <div class="checkbox-control">
                  <facet-link class="block w-full">
                    <a href="{{ vendor_target_url | strip }}" data-tag-link="true" class="tap-area text-subdued no-hover-underline" style="display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 2px 0;">
                      <span style="display: inline-flex; align-items: center; gap: 0.75rem;">
                        <span class="luxury-facet-checkbox{% if is_vendor_active %} luxury-facet-checkbox--active{% endif %}"></span>
                        <span class="{% if is_vendor_active %}font-semibold text-primary{% else %}text-subdued{% endif %}" style="letter-spacing: 0.02em;">{{ display_vendor }}</span>
                      </span>
                    </a>
                  </facet-link>
                </div>
              {%- endfor -%}
            </div>
          {%- endcapture -%}

          {%- assign brand_open = open_filters_by_default -%}
          {%- if active_vendor_tag != '' -%}
            {%- assign brand_open = true -%}
          {%- endif -%}
          {%- render 'accordion', title: 'Brand', content: brand_filter_content, open: brand_open, show_arrow: true -%}
        {%- endif -%}

        {%- for filter in results.filters -%}
          {%- capture filter_content -%}
            {%- if filter.type == 'boolean' or filter.param_name == 'filter.v.availability' -%}
              {%- if filter.param_name == 'filter.v.availability' -%}
                <div class="checkbox-control">
                  <input id="{{ id_prefix }}-{{ filter.param_name }}" type="checkbox" class="switch" name="{{ filter.param_name }}" value="1" {% if filter.active_values.size > 0 %}checked{% endif %}>
                  <label for="{{ id_prefix }}-{{ filter.param_name }}" class="text-subdued">{{- 'collection.faceting.in_stock_only' | t -}}</label>
                </div>
              {%- else -%}
                <div class="v-stack gap-2.5">
                  {%- for filter_value in filter.values -%}
                    {%- liquid
                      if section.settings.show_filter_values_count
                        assign label = filter_value.label | append: ' (' | append: filter_value.count | append: ')'
                      else
                        assign label = filter_value.label
                      endif
                    -%}

                    <div class="checkbox-control">
                      {%- capture boolean_index -%}{% increment filter_boolean %}{%- endcapture -%}

                      <input id="{{ id_prefix }}-{{ filter_value.param_name }}-{{ boolean_index }}" type="checkbox" class="switch" name="{{ filter_value.param_name }}" value="{{ filter_value.value }}" {% if filter_value.active %}checked{% endif %}>
                      <label for="{{ id_prefix }}-{{ filter_value.param_name }}-{{ boolean_index }}" class="text-subdued">{{ label }}</label>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            {%- else -%}
              {%- assign downcase_label = filter.label | downcase -%}

              {%- case filter.type -%}
                {%- when 'list' -%}
                  {%- liquid
                    if filter.presentation == 'image'
                      assign wrapper_class_list = 'v-stack gap-2'
                    elsif filter.presentation == 'swatch' or color_label_list contains downcase_label
                      assign wrapper_class_list = 'h-stack wrap gap-2'
                    else
                      assign wrapper_class_list = 'v-stack gap-2.5'
                    endif
                  -%}

                  <div class="{{ wrapper_class_list }}">
                    {% liquid
                      for filter_value in filter.values
                        assign value_id_prefix = id_prefix | append: '-' | append: forloop.index

                        if filter.presentation == 'image'
                          render 'option-value', type: 'image_filter', filter_value: filter_value, id_prefix: value_id_prefix
                        elsif filter.presentation == 'swatch' or color_label_list contains downcase_label
                          render 'option-value', type: 'swatch', filter_value: filter_value, show_tooltip: true, id_prefix: value_id_prefix
                        else
                          if section.settings.show_filter_values_count
                            assign label = filter_value.label | append: ' (' | append: filter_value.count | append: ')'
                          else
                            assign label = filter_value.label
                          endif

                          render 'checkbox', hide_checkbox: true, label: label, name: filter_value.param_name, value: filter_value.value, checked: filter_value.active, id_prefix: value_id_prefix
                        endif
                      endfor
                    %}
                  </div>

                {%- when 'price_range' -%}
                  {%- render 'price-range', filter: filter -%}
              {%- endcase -%}
            {%- endif -%}
          {%- endcapture -%}

          {%- if filter_content != blank -%}
            {%- render 'accordion', title: filter.label, content: filter_content, open: open_filters_by_default, show_arrow: true -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <noscript style="display: block; margin-top: 20px;">
      {%- assign button_content = 'collection.faceting.apply_filters' | t -%}
      {%- render 'button', content: button_content, stretch: true -%}
    </noscript>
  </form>
</facets-form>