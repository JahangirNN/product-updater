  .luxury-atelier-pill:hover {
    background: #1a1a1a;
    color: #ffffff;
    border-color: #1a1a1a;
    transform: translateY(-1px);
  }

  /* Column 2: Master Horology & Swiss Watchmakers */
  .luxury-horology-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
