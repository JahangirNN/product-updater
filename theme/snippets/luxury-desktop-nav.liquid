{%- comment -%}
  Luxury Desktop Mega-Menu Navigation (ADR 0022 - 2026 Minimal Modern Luxury Edition)
  Features distinct departmental mega-menus for Women and Men, an A-Z Designer Directory,
  clean geometric uppercase typography, and zero horizontal overflow.
{%- endcomment -%}

<style>
  /* 2026 Modern Minimal Luxury Navigation Styling */
  .luxury-nav-item {
    position: static !important;
  }

  .luxury-nav__trigger {
    font-family: var(--text-font-family);
    font-size: 0.8125rem !important;
    font-weight: 500 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    color: rgb(var(--text-color));
    padding: 0.6rem 0.35rem;
    position: relative;
    cursor: pointer;
    transition: opacity 0.2s ease, color 0.2s ease;
    display: flex;
    align-items: center;
    white-space: nowrap !important;
    text-decoration: none !important;
  }

  /* Suppress default theme duplicate underline pseudo-element */
  .header__primary-nav-item [data-title]:before,
  .header__primary-nav-item [data-title]:hover:before,
  .luxury-nav__trigger:before {
    display: none !important;
    content: none !important;
  }

  .luxury-nav__trigger::after {
    content: '';
    position: absolute;
    bottom: 0px;
    left: 50%;
    width: 0;
    height: 1.5px;
    background-color: #c9a876;
    transition: width 0.25s cubic-bezier(0.25, 1, 0.5, 1), left 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .header__primary-nav-item:hover .luxury-nav__trigger::after,
  .luxury-nav-item:hover .luxury-nav__trigger::after,
  details[open] > .luxury-nav__trigger::after {
    width: 100%;
    left: 0;
  }

  /* Full-width seamless mega-menu without horizontal scrollbars */
  .luxury-mega-menu {
    position: absolute !important;
    top: 100% !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    overflow-x: hidden !important;
    max-height: calc(100vh - 120px) !important;
    overflow-y: auto !important;
    background: rgba(255, 255, 255, 0.98) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(0, 0, 0, 0.05);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.07);
    padding: 2.25rem 2rem 2.5rem !important;
    z-index: 99;
  }

  .luxury-mega-menu::-webkit-scrollbar {
    width: 5px;
  }
  .luxury-mega-menu::-webkit-scrollbar-track {
    background: transparent;
  }
  .luxury-mega-menu::-webkit-scrollbar-thumb {
    background: rgba(201, 168, 118, 0.35);
    border-radius: 4px;
  }
  .luxury-mega-menu::-webkit-scrollbar-thumb:hover {
    background: rgba(201, 168, 118, 0.7);
  }

  .luxury-mega-menu__inner {
    max-width: min(1380px, 96vw);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    width: 100%;
    box-sizing: border-box;
  }

  .luxury-mega-menu__columns {
    display: grid !important;
    grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
    gap: 1.5rem !important;
    flex: 1 1 auto;
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  .luxury-mega-menu__col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  @media screen and (max-width: 1280px) {
    .luxury-mega-menu {
      padding: 1.75rem 1.25rem 2rem !important;
    }
    .luxury-mega-menu__inner {
      max-width: 98vw !important;
      gap: 1.25rem !important;
    }
    .luxury-mega-menu__columns {
      gap: 1rem !important;
    }
    .luxury-mega-menu__promo {
      flex: 0 0 210px !important;
      width: 210px !important;
      max-width: 210px !important;
      padding: 1.15rem !important;
    }
    .luxury-mega-menu__col-title {
      font-size: 0.6875rem !important;
      letter-spacing: 0.11em !important;
      padding-bottom: 0.5rem !important;
      margin-bottom: 0.65rem !important;
    }
    .luxury-mega-menu__link {
      font-size: 0.75rem !important;
    }
    .luxury-mega-menu__link--accent {
      font-size: 0.6875rem !important;
    }
  }

  @media screen and (max-width: 1120px) {
