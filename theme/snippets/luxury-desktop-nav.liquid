    font-family: var(--text-font-family);
    font-size: 0.7188rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #1a1a1a;
    padding-bottom: 0.65rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .luxury-mega-menu__col-title:hover {
    color: #c9a876;
  }

  .luxury-mega-menu__list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .luxury-mega-menu__link {
    font-family: var(--text-font-family);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    color: #555555;
    text-decoration: none;
    display: inline-block;
    padding: 0.15rem 0;
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .luxury-mega-menu__link:hover {
    color: #000000;
    transform: translateX(3px);
  }

  .luxury-mega-menu__link--accent {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c9a876;
    margin-bottom: 0.35rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .luxury-mega-menu__link--accent:hover {
    color: #1a1a1a;
    transform: translateX(3px);
  }

  .luxury-mega-menu,
  .luxury-mega-menu__inner {
    white-space: normal !important;
  }

  .luxury-mega-menu__promo {
    flex: 0 0 280px !important;
    width: 280px !important;
    max-width: 280px !important;
    min-width: 0 !important;
    background: #fbfaf8;
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-top: 2px solid #c9a876;
    border-radius: 1px;
    padding: 1.5rem !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    box-sizing: border-box !important;
    min-height: 220px;
    overflow: hidden !important;
    white-space: normal !important;
  }

  .luxury-mega-menu__promo > * {
