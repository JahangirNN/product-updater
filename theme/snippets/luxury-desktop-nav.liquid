{%- comment -%}
  Luxury Desktop Mega-Menu Navigation (ADR 0022 - 2026 Minimal Modern Luxury Edition)
  Features distinct departmental mega-menus for Women and Men, an A-Z Designer Directory,
  clean geometric uppercase typography, and zero horizontal overflow.
{%- endcomment -%}

<style>
  /* 2026 Modern Minimal Luxury Navigation Styling */
  .luxury-nav-item {
    position: static !important;
  }

  .luxury-nav__trigger {
    font-family: var(--text-font-family);
    font-size: 0.8125rem !important;
    font-weight: 500 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    color: rgb(var(--text-color));
    padding: 0.6rem 0.35rem;
    position: relative;
    cursor: pointer;
    transition: opacity 0.2s ease, color 0.2s ease;
    display: flex;
    align-items: center;
    white-space: nowrap !important;
    text-decoration: none !important;
  }

  .luxury-nav__trigger::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 1.5px;
    background-color: #c9a876;
    transition: width 0.25s cubic-bezier(0.25, 1, 0.5, 1), left 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .header__primary-nav-item:hover .luxury-nav__trigger::after,
  .luxury-nav-item:hover .luxury-nav__trigger::after,
  details[open] > .luxury-nav__trigger::after {
    width: 100%;
    left: 0;
  }

  /* Full-width seamless mega-menu without horizontal scrollbars */
  .luxury-mega-menu {
    position: absolute !important;
    top: 100% !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    overflow-x: hidden !important;
    background: rgba(255, 255, 255, 0.98) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(0, 0, 0, 0.05);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.07);
    padding: 2.25rem 2rem 2.5rem !important;
    z-index: 99;
  }

  .luxury-mega-menu__inner {
    max-width: min(1240px, 94vw);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  .luxury-mega-menu__columns {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(130px, 1fr)) !important;
    column-gap: 2.5rem;
    row-gap: 2rem;
    flex: 1 1 auto;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .luxury-mega-menu__col {
    display: flex;
    flex-direction: column;
  }

  .luxury-mega-menu__col-title {
    display: block;
    font-family: var(--text-font-family);
    font-size: 0.7188rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #1a1a1a;
    padding-bottom: 0.65rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .luxury-mega-menu__col-title:hover {
    color: #c9a876;
  }

  .luxury-mega-menu__list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .luxury-mega-menu__link {
    font-family: var(--text-font-family);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    color: #555555;
    text-decoration: none;
    display: inline-block;
    padding: 0.15rem 0;
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .luxury-mega-menu__link:hover {
    color: #000000;
    transform: translateX(3px);
  }

  .luxury-mega-menu__link--accent {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c9a876;
    margin-bottom: 0.35rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .luxury-mega-menu__link--accent:hover {
    color: #1a1a1a;
    transform: translateX(3px);
  }

  .luxury-mega-menu,
  .luxury-mega-menu__inner {
    white-space: normal !important;
  }

  .luxury-mega-menu__promo {
    flex: 0 0 280px !important;
    width: 280px !important;
    max-width: 280px !important;
    min-width: 0 !important;
    background: #fbfaf8;
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-top: 2px solid #c9a876;
    border-radius: 1px;
    padding: 1.5rem !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    box-sizing: border-box !important;
    min-height: 220px;
    overflow: hidden !important;
    white-space: normal !important;
  }

  .luxury-mega-menu__promo > * {
    flex: none !important;
    min-width: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
    box-sizing: border-box !important;
    white-space: normal !important;
  }

  .luxury-mega-menu__promo-tag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a876;
    margin-bottom: 0.5rem;
    white-space: nowrap !important;
    display: block;
  }

  .luxury-mega-menu__promo-heading {
    font-family: var(--heading-font-family);
    font-size: 1.1875rem;
    font-weight: 400;
    line-height: 1.35;
    color: #1a1a1a;
    margin: 0 0 0.65rem 0;
    white-space: normal !important;
    word-break: normal !important;
    overflow-wrap: break-word !important;
    display: block;
  }

  .luxury-mega-menu__promo-body {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: #666666;
    margin: 0 0 1.25rem 0;
    white-space: normal !important;
    word-break: normal !important;
    overflow-wrap: break-word !important;
    hyphens: auto;
    display: block;
  }

  .luxury-mega-menu__promo-cta {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1a1a1a;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 3px;
    width: fit-content !important;
    max-width: 100% !important;
    margin-top: auto;
    white-space: nowrap !important;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .luxury-mega-menu__promo-cta:hover {
    color: #c9a876;
    border-color: #c9a876;
  }
</style>

