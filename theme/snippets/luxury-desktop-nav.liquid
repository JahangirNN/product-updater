  }

  .luxury-mega-menu__promo-cta:hover {
    color: #c9a876;
    border-color: #c9a876;
  }

  /* Brands Specific 4-Column Luxury Architecture (ADR 0022/2026) */
  .luxury-mega-menu__inner--brands {
    display: grid !important;
    grid-template-columns: 1.15fr 1fr 1.05fr 1fr !important;
    gap: 1.75rem !important;
    align-items: stretch !important;
    max-width: min(1380px, 96vw) !important;
  }

  @media screen and (min-width: 1000px) and (max-width: 1280px) {
    .luxury-mega-menu__inner--brands {
      grid-template-columns: 1.1fr 1fr 1fr 1fr !important;
      gap: 1rem !important;
      max-width: 98vw !important;
    }
  }

  .luxury-brands-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Column 1: Leather Goods & Ateliers Cards */
  .luxury-ateliers-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .luxury-atelier-card {
