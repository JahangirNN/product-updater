      padding: 1.5rem 1rem 1.75rem !important;
    }
    .luxury-mega-menu__inner {
      gap: 0.85rem !important;
    }
    .luxury-mega-menu__columns {
      gap: 0.75rem !important;
    }
    .luxury-mega-menu__promo {
      flex: 0 0 185px !important;
      width: 185px !important;
      max-width: 185px !important;
      padding: 0.95rem !important;
    }
    .luxury-mega-menu__col-title {
      font-size: 0.6563rem !important;
      letter-spacing: 0.08em !important;
    }
    .luxury-mega-menu__link {
      font-size: 0.7188rem !important;
    }
  }

  .luxury-mega-menu__col-title {
