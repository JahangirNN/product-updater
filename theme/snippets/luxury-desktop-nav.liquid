    white-space: normal !important;
  }

  .luxury-mega-menu__promo-tag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a876;
    margin-bottom: 0.5rem;
    white-space: nowrap !important;
    display: block;
  }

  .luxury-mega-menu__promo-heading {
    font-family: var(--heading-font-family);
    font-size: 1.1875rem;
    font-weight: 400;
    line-height: 1.35;
    color: #1a1a1a;
    margin: 0 0 0.65rem 0;
    white-space: normal !important;
    word-break: normal !important;
    overflow-wrap: break-word !important;
    display: block;
  }

  .luxury-mega-menu__promo-body {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: #666666;
    margin: 0 0 1.25rem 0;
    white-space: normal !important;
    word-break: normal !important;
    overflow-wrap: break-word !important;
    -webkit-hyphens: manual;
    hyphens: manual;
    display: block;
  }

  .luxury-mega-menu__promo-cta {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1a1a1a;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 3px;
