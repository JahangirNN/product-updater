{%- comment -%}
  Luxury 3-Tier Sidebar Panels (ADR 0022)
  Provides Women, Men, and Designers hierarchical navigation panels for Prestige theme header-sidebar.
{%- endcomment -%}

<div id="header-panel-women" class="header-sidebar__sub-panel" hidden>
  <button type="button" class="header-sidebar__back-button link-faded {% if show_dividers %}is-divided{% endif %} text-with-icon {% if section.settings.sidebar_text_font == 'heading' %}h6{% endif %} md:hidden" data-action="close-panel">
    {%- render 'icon' with 'chevron-left', width: 12, direction_aware: true -%}
    Women
  </button>

  <ul class="header-sidebar__linklist {% if show_dividers %}divide-y{% endif %} unstyled-list" role="list">
    <li>
      <a href="/collections/women" class="header-sidebar__linklist-button {% if section.settings.sidebar_text_font == 'heading' %}h6{% endif %}" style="font-weight: 600; color: #c9a876;">
        Shop All Women's Boutique &rarr;
      </a>
    </li>

    <li>
      <accordion-disclosure>
        <details class="accordion__disclosure group" {% if open_second_level_menus %}open{% endif %}>
          <summary class="header-sidebar__linklist-button {% if section.settings.sidebar_text_font == 'heading' %}h6{% endif %}">
            Luxury Watches
            <span class="animated-plus group-expanded:rotate" aria-hidden="true"></span>
          </summary>
          <div class="header-sidebar__nested-linklist">
            <a href="/collections/womens-watches" class="link-faded-reverse" style="font-weight: 600; color: #c9a876;">Shop All Women's Watches</a>
            <a href="/collections/womens-watches/tissot" class="link-faded-reverse">Tissot</a>
            <a href="/collections/womens-watches/seiko" class="link-faded-reverse">Seiko</a>
            <a href="/collections/womens-watches/citizen" class="link-faded-reverse">Citizen</a>
            <a href="/collections/womens-watches/movado" class="link-faded-reverse">Movado</a>
            <a href="/collections/womens-watches/versace" class="link-faded-reverse">Versace</a>
            <a href="/collections/womens-watches/michael-kors" class="link-faded-reverse">Michael Kors</a>
          </div>
        </details>
      </accordion-disclosure>
    </li>

    <li>
      <accordion-disclosure>
        <details class="accordion__disclosure group" {% if open_second_level_menus %}open{% endif %}>
          <summary class="header-sidebar__linklist-button {% if section.settings.sidebar_text_font == 'heading' %}h6{% endif %}">
            Designer Bags
            <span class="animated-plus group-expanded:rotate" aria-hidden="true"></span>
          </summary>
          <div class="header-sidebar__nested-linklist">
            <a href="/collections/womens-handbags" class="link-faded-reverse" style="font-weight: 600; color: #c9a876;">Shop All Handbags</a>
            <a href="/collections/womens-handbags/jw-pei" class="link-faded-reverse">JW PEI</a>
          </div>
        </details>
      </accordion-disclosure>
    </li>
  </ul>
</div>

