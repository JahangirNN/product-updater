{%- comment -%}
  Luxury 3-Tier Sidebar Panels (ADR 0022)
  Provides Women, Men, and Designers hierarchical navigation panels for Prestige theme header-sidebar.
{%- endcomment -%}

<style>
  .header-sidebar__sub-panel .header-sidebar__linklist,
  #header-panel-brands .header-sidebar__linklist {
    padding-bottom: max(3.5rem, env(safe-area-inset-bottom, 2.5rem)) !important;
  }

  /* Luxury Mobile Brands Drawer (ADR 0022/2026) */
  .luxury-sidebar__section-title {
    padding: 0.9rem 1.25rem 0.45rem !important;
    font-size: 0.6875rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    color: #8c827a !important;
    background: #faf8f5 !important;
    border-top: 1px solid rgba(0, 0, 0, 0.05) !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04) !important;
    display: flex !important;
    align-items: center !important;
    list-style: none !important;
  }

  .luxury-sidebar__all-link-btn {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 0.95rem 1.25rem !important;
    font-size: 0.8125rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.09em !important;
    text-transform: uppercase !important;
    color: #c9a876 !important;
    background: #ffffff !important;
    text-decoration: none !important;
    transition: background 0.2s ease, color 0.2s ease !important;
  }

  .luxury-sidebar__all-link-btn:hover {
    background: #faf8f5 !important;
    color: #1a1a1a !important;
  }

  .luxury-sidebar__brand-btn {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    width: 100% !important;
  }

  .luxury-sidebar__brand-name {
    font-weight: 500;
    color: #1a1a1a;
    letter-spacing: 0.02em;
  }

  .luxury-sidebar__chip {
    font-size: 0.625rem !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    font-weight: 500 !important;
    padding: 0.2rem 0.5rem !important;
    border-radius: 999px !important;
    background: rgba(201, 168, 118, 0.12) !important;
    color: #8a6c38 !important;
    border: 1px solid rgba(201, 168, 118, 0.25) !important;
    margin-left: auto !important;
    margin-right: 0.75rem !important;
    white-space: nowrap !important;
    line-height: 1.2 !important;
  }

  .luxury-sidebar__arrow {
    color: #bbb;
    font-size: 0.75rem;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .header-sidebar__linklist-button:hover .luxury-sidebar__arrow {
    transform: translateX(2px);
    color: #c9a876;
  }
</style>

