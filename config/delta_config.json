{
  "check_interval_minutes": 60,
  "default_max_workers": 2,
  "default_requests_per_second": 2.0,
  "default_delay_seconds": 0.5,
  "default_timeout_seconds": 8.0,
  "store_configs": {
    "jwpei": {
      "check_interval_minutes": 60,
      "engine": "http",
      "max_workers": 2,
      "requests_per_second": 2.0,
      "delay_seconds": 0.5,
      "timeout_seconds": 8.0,
      "endpoint_pattern": "https://www.jwpei.com/products/{handle}.js"
    },
    "nordstrom": {
      "check_interval_minutes": 60,
      "engine": "camoufox",
      "max_workers": 1,
      "requests_per_second": 0.5,
      "delay_seconds": 1.5,
      "timeout_seconds": 45.0,
      "endpoint_pattern": "https://www.nordstrom.com/s/{handle}/{id}"
    },
    "michaelkors": {
      "check_interval_minutes": 60,
      "engine": "camoufox",
      "max_workers": 1,
      "requests_per_second": 0.5,
      "delay_seconds": 1.5,
      "timeout_seconds": 30.0,
      "endpoint_pattern": "https://www.michaelkors.com/{handle}/{id}.html"
    }
  },
  "shopify_sync": {
    "auto_sync_on_delta": false,
    "queue_file": "storage/db/history/delta_events.json"
  },
  "logging": {
    "log_dir": "logs",
    "general_log": "freshner.log",
    "error_log": "errors.log",
    "rotation_general": "20 MB",
    "rotation_error": "10 MB",
    "retention_general": "14 days",
    "retention_error": "30 days",
    "console_level": "INFO"
  }
}
